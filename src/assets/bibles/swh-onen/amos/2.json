{"verses":[{"verse":1,"text":"Hili ndilo asemalo \\nd Bwana\\nd*:"},{"verse":2,"text":"Nitatuma moto juu ya Moabu"},{"verse":3,"text":"Nitamwangamiza mtawala wake"},{"verse":4,"text":"Hili ndilo asemalo \\nd Bwana\\nd*:"},{"verse":5,"text":"Nitatuma moto juu ya Yuda"},{"verse":6,"text":"Hili ndilo asemalo \\nd Bwana\\nd*:"},{"verse":7,"text":"Wanakanyaga juu ya vichwa vya maskini,"},{"verse":8,"text":"Watu hulala kando ya kila madhabahu"},{"verse":9,"text":"“Nilimwangamiza Mwamori mbele yao,"},{"verse":10,"text":"“Niliwapandisha toka Misri,"},{"verse":11,"text":"Pia niliinua manabii kutoka miongoni mwa wana wenu"},{"verse":12,"text":"“Lakini mliwafanya Wanadhiri kunywa mvinyo"},{"verse":13,"text":"“Sasa basi, nitawaponda"},{"verse":14,"text":"Mkimbiaji hodari hatanusurika,"},{"verse":15,"text":"Mpiga upinde atakimbia,"},{"verse":16,"text":"Hata askari walio mashujaa sana"}]}