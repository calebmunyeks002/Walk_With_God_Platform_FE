{"verses":[{"verse":1,"text":"Heri mtu yule anayemjali mnyonge,"},{"verse":2,"text":"\\nd Bwana\\nd* atamlinda na kuyahifadhi maisha yake,"},{"verse":3,"text":"\\nd Bwana\\nd* atamtegemeza awapo mgonjwa kitandani,"},{"verse":4,"text":"Nilisema, “Ee \\nd Bwana\\nd* nihurumie,"},{"verse":5,"text":"Adui zangu wanasema kwa hila,"},{"verse":6,"text":"Kila anapokuja mtu kunitazama,"},{"verse":7,"text":"Adui zangu wote hunongʼonezana dhidi yangu,"},{"verse":8,"text":"“Ugonjwa mbaya sana umempata,"},{"verse":9,"text":"Hata rafiki yangu wa karibu niliyemwamini,"},{"verse":10,"text":"Lakini wewe, Ee \\nd Bwana\\nd*, nihurumie,"},{"verse":11,"text":"Najua kwamba wapendezwa nami,"},{"verse":12,"text":"Katika uadilifu wangu unanitegemeza"},{"verse":13,"text":"Msifuni \\nd Bwana\\nd*, Mungu wa Israeli,"}]}