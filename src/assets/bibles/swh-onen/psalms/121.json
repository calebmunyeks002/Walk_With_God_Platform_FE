{"verses":[{"verse":1,"text":"Nayainua macho yangu nitazame vilima,"},{"verse":2,"text":"Msaada wangu hutoka kwa \\nd Bwana\\nd*,"},{"verse":3,"text":"Hatauacha mguu wako uteleze,"},{"verse":4,"text":"hakika, yeye alindaye Israeli"},{"verse":5,"text":"\\nd Bwana\\nd* anakulinda,"},{"verse":6,"text":"jua halitakudhuru mchana,"},{"verse":7,"text":"\\nd Bwana\\nd* atakukinga na madhara yote,"},{"verse":8,"text":"\\nd Bwana\\nd* atakulinda unapoingia na unapotoka,"}]}