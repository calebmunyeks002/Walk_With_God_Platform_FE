{"verses":[{"verse":1,"text":"Pigeni makofi, enyi mataifa yote,"},{"verse":2,"text":"Jinsi gani alivyo wa kutisha, \\nd Bwana\\nd* Aliye Juu Sana,"},{"verse":3,"text":"Ametiisha mataifa chini yetu"},{"verse":4,"text":"Alituchagulia urithi wetu,"},{"verse":5,"text":"Mungu amepaa kwa kelele za shangwe,"},{"verse":6,"text":"Mwimbieni Mungu sifa, imbeni sifa,"},{"verse":7,"text":"Kwa kuwa Mungu ni mfalme wa dunia yote,"},{"verse":8,"text":"Mungu anatawala juu ya mataifa,"},{"verse":9,"text":"Wakuu wa mataifa wanakusanyika"}]}