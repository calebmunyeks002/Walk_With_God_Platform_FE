{"verses":[{"verse":1,"text":"Ee Mungu, sifa zakungojea katika Sayuni;"},{"verse":2,"text":"Ewe usikiaye maombi,"},{"verse":3,"text":"Tulipokuwa tumefunikwa kabisa na dhambi,"},{"verse":4,"text":"Heri wale uliowachagua"},{"verse":5,"text":"Unatujibu kwa matendo ya kushangaza ya haki,"},{"verse":6,"text":"uliyeumba milima kwa uwezo wako,"},{"verse":7,"text":"uliyenyamazisha dhoruba za bahari,"},{"verse":8,"text":"Wale wanaoishi mbali sana"},{"verse":9,"text":"Waitunza nchi na kuinyeshea,"},{"verse":10,"text":"Umeilowesha mifereji yake"},{"verse":11,"text":"Umeuvika mwaka taji ya baraka,"},{"verse":12,"text":"Mbuga za majani za jangwani umezineemesha;"},{"verse":13,"text":"Penye nyanda za malisho pamejaa makundi ya wanyama,"}]}