{"verses":[{"verse":1,"text":"Ee \\nd Bwana\\nd*, sikia sala yangu,"},{"verse":2,"text":"Usimhukumu mtumishi wako,"},{"verse":3,"text":"Adui hunifuatilia,"},{"verse":4,"text":"Kwa hiyo roho yangu inazimia ndani yangu,"},{"verse":5,"text":"Nakumbuka siku za zamani;"},{"verse":6,"text":"Nanyoosha mikono yangu kwako,"},{"verse":7,"text":"Ee \\nd Bwana\\nd*, unijibu haraka,"},{"verse":8,"text":"Asubuhi uniletee neno la upendo wako usiokoma,"},{"verse":9,"text":"Ee \\nd Bwana\\nd*, uniokoe na adui zangu,"},{"verse":10,"text":"Nifundishe kufanya mapenzi yako,"},{"verse":11,"text":"Ee \\nd Bwana\\nd*, kwa ajili ya jina lako, hifadhi maisha yangu,"},{"verse":12,"text":"Kwa upendo wako usiokoma,"}]}