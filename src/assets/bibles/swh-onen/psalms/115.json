{"verses":[{"verse":1,"text":"Sio kwetu sisi, Ee \\nd Bwana\\nd*, sio kwetu sisi,"},{"verse":2,"text":"Kwa nini mataifa waseme,"},{"verse":3,"text":"Mungu wetu yuko mbinguni,"},{"verse":4,"text":"Lakini sanamu zao ni za fedha na dhahabu,"},{"verse":5,"text":"Zina vinywa, lakini haziwezi kusema,"},{"verse":6,"text":"zina masikio, lakini haziwezi kusikia,"},{"verse":7,"text":"zina mikono, lakini haziwezi kupapasa,"},{"verse":8,"text":"Wale wanaozitengeneza watafanana nazo,"},{"verse":9,"text":"Ee nyumba ya Israeli, mtumainini \\nd Bwana\\nd*,"},{"verse":10,"text":"Ee nyumba ya Aroni, mtumainini \\nd Bwana\\nd*,"},{"verse":11,"text":"Ninyi mnaomcha, mtumainini \\nd Bwana\\nd*,"},{"verse":12,"text":"\\nd Bwana\\nd* anatukumbuka na atatubariki:"},{"verse":13,"text":"atawabariki wale wanaomcha \\nd Bwana\\nd*,"},{"verse":14,"text":"\\nd Bwana\\nd* na awawezeshe kuongezeka,"},{"verse":15,"text":"Mbarikiwe na \\nd Bwana\\nd*"},{"verse":16,"text":"Mbingu zilizo juu sana ni mali ya \\nd Bwana\\nd*,"},{"verse":17,"text":"Sio wafu wanaomsifu \\nd Bwana\\nd*,"},{"verse":18,"text":"bali ni sisi tunaomtukuza \\nd Bwana\\nd*,"}]}