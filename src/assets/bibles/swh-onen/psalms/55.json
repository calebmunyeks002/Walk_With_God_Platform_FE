{"verses":[{"verse":1,"text":"Ee Mungu, sikiliza maombi yangu,"},{"verse":2,"text":"Nisikie na unijibu."},{"verse":3,"text":"kwa sauti ya adui,"},{"verse":4,"text":"Moyo wangu umejaa uchungu,"},{"verse":5,"text":"Woga na kutetemeka vimenizunguka,"},{"verse":6,"text":"Nilisema, “Laiti ningekuwa na mbawa za njiwa!"},{"verse":7,"text":"Ningalitorokea mbali sana"},{"verse":8,"text":"ningaliharakisha kwenda mahali pa salama,"},{"verse":9,"text":"Ee \\nd Bwana\\nd*, uwatahayarishe waovu"},{"verse":10,"text":"Usiku na mchana wanazunguka juu ya kuta zake,"},{"verse":11,"text":"Nguvu za uharibifu zinatenda kazi mjini,"},{"verse":12,"text":"Kama aliyenitukana ni adui yangu, ningevumilia,"},{"verse":13,"text":"Kumbe ni wewe, mwenzangu,"},{"verse":14,"text":"ambaye awali tulifurahia ushirika mzuri,"},{"verse":15,"text":"Kifo na kiwajie adui zangu ghafula,"},{"verse":16,"text":"Lakini ninamwita Mungu,"},{"verse":17,"text":"Jioni, asubuhi na adhuhuri"},{"verse":18,"text":"Huniokoa nikawa salama katika vita"},{"verse":19,"text":"Mungu anayemiliki milele,"},{"verse":20,"text":"Mwenzangu hushambulia rafiki zake,"},{"verse":21,"text":"Mazungumzo yake ni laini kama siagi,"},{"verse":22,"text":"Mtwike \\nd Bwana\\nd* fadhaa zako,"},{"verse":23,"text":"Lakini wewe, Ee Mungu,"}]}