{"verses":[{"verse":1,"text":"Nilimlilia Mungu ili anisaidie,"},{"verse":2,"text":"Nilipokuwa katika taabu, nilimtafuta Bwana,"},{"verse":3,"text":"Ee Mungu, nilikukumbuka wewe, nikalia kwa huzuni;"},{"verse":4,"text":"Ulizuia macho yangu kufumba;"},{"verse":5,"text":"Nilitafakari juu ya siku zilizopita,"},{"verse":6,"text":"nilikumbuka nilivyoimba nyimbo usiku."},{"verse":7,"text":"“Je, Bwana atakataa milele?"},{"verse":8,"text":"Je, upendo wake usio na mwisho umetoweka milele?"},{"verse":9,"text":"Je, Mungu amesahau kuwa na huruma?"},{"verse":10,"text":"Ndipo nikawaza, “Huu ndio udhaifu wangu:"},{"verse":11,"text":"Nitayakumbuka matendo ya \\nd Bwana\\nd*;"},{"verse":12,"text":"Nitazitafakari kazi zako zote"},{"verse":13,"text":"Ee Mungu, njia zako ni takatifu."},{"verse":14,"text":"Wewe ndiwe Mungu utendaye miujiza,"},{"verse":15,"text":"Kwa mkono wako wenye nguvu umewakomboa watu wako,"},{"verse":16,"text":"Maji yalikuona, Ee Mungu,"},{"verse":17,"text":"Mawingu yalimwaga maji,"},{"verse":18,"text":"Ngurumo yako ilisikika katika upepo wa kisulisuli,"},{"verse":19,"text":"Njia yako ilipita baharini,"},{"verse":20,"text":"Uliongoza watu wako kama kundi"}]}