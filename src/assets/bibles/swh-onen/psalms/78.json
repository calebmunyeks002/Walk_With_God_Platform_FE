{"verses":[{"verse":1,"text":"Enyi watu wangu, sikieni mafundisho yangu,"},{"verse":2,"text":"Nitafungua kinywa changu kwa mafumbo,"},{"verse":3,"text":"yale ambayo tuliyasikia na kuyajua,"},{"verse":4,"text":"Hatutayaficha kwa watoto wao;"},{"verse":5,"text":"Aliagiza amri kwa Yakobo"},{"verse":6,"text":"ili kizazi kijacho kizijue,"},{"verse":7,"text":"Ndipo wangeweka tumaini lao kwa Mungu,"},{"verse":8,"text":"Ili wasifanane na baba zao,"},{"verse":9,"text":"Watu wa Efraimu, ingawa walijifunga pinde,"},{"verse":10,"text":"Hawakulishika agano la Mungu"},{"verse":11,"text":"Walisahau aliyokuwa ameyatenda,"},{"verse":12,"text":"Alitenda miujiza machoni mwa baba zao,"},{"verse":13,"text":"Aliigawanya bahari akawapitisha,"},{"verse":14,"text":"Aliwaongoza kwa wingu mchana"},{"verse":15,"text":"Alipasua miamba jangwani"},{"verse":16,"text":"alitoa vijito kutoka kwenye jabali lililochongoka,"},{"verse":17,"text":"Lakini waliendelea kutenda dhambi dhidi yake,"},{"verse":18,"text":"Kwa makusudi walimjaribu Mungu,"},{"verse":19,"text":"Walinena dhidi ya Mungu, wakisema,"},{"verse":20,"text":"Alipopiga mwamba, maji yalitoka kwa nguvu,"},{"verse":21,"text":"\\nd Bwana\\nd* alipowasikia, alikasirika sana,"},{"verse":22,"text":"kwa kuwa hawakumwamini Mungu,"},{"verse":23,"text":"Hata hivyo alitoa amri kwa anga zilizo juu"},{"verse":24,"text":"akawanyeshea mana ili watu wale;"},{"verse":25,"text":"Watu walikula mkate wa malaika,"},{"verse":26,"text":"Aliachia upepo wa mashariki kutoka kwenye mbingu"},{"verse":27,"text":"Aliwanyeshea nyama kama mavumbi,"},{"verse":28,"text":"Aliwafanya washuke ndani ya kambi yao,"},{"verse":29,"text":"Walikula na kusaza,"},{"verse":30,"text":"Kabla hawajamaliza kula walichokitamani,"},{"verse":31,"text":"hasira ya Mungu ikawaka juu yao,"},{"verse":32,"text":"Licha ya haya yote, waliendelea kutenda dhambi,"},{"verse":33,"text":"Kwa hiyo akamaliza siku zao katika ubatili"},{"verse":34,"text":"Kila mara Mungu alipowaua baadhi yao,"},{"verse":35,"text":"Walikumbuka kwamba Mungu alikuwa Mwamba wao,"},{"verse":36,"text":"Lakini walimdanganya kwa vinywa vyao,"},{"verse":37,"text":"mioyo yao haikuwa thabiti kwake,"},{"verse":38,"text":"Hata hivyo alikuwa na huruma,"},{"verse":39,"text":"Alikumbuka kwamba wao walikuwa nyama tu,"},{"verse":40,"text":"Mara ngapi walimwasi jangwani"},{"verse":41,"text":"Walimjaribu Mungu mara kwa mara,"},{"verse":42,"text":"Hawakukumbuka uwezo wake,"},{"verse":43,"text":"siku aliyoonyesha ishara zake za ajabu huko Misri,"},{"verse":44,"text":"Aligeuza mito yao kuwa damu,"},{"verse":45,"text":"Aliwapelekea makundi ya mainzi yakawala,"},{"verse":46,"text":"Aliruhusu tunutu kuharibu mimea yao,"},{"verse":47,"text":"Aliharibu mizabibu yao kwa mvua ya mawe"},{"verse":48,"text":"Aliwaachia mifugo yao mvua ya mawe,"},{"verse":49,"text":"Aliwafungulia hasira yake kali,"},{"verse":50,"text":"Aliitengenezea njia hasira yake,"},{"verse":51,"text":"Aliwapiga wazaliwa wote wa kwanza wa Misri,"},{"verse":52,"text":"Lakini aliwatoa watu wake kama kundi,"},{"verse":53,"text":"Aliwaongoza salama, wala hawakuogopa,"},{"verse":54,"text":"Hivyo akawaleta hadi kwenye mpaka wa nchi yake takatifu,"},{"verse":55,"text":"Aliyafukuza mataifa mbele yao,"},{"verse":56,"text":"Lakini wao walimjaribu Mungu,"},{"verse":57,"text":"Kama baba zao, hawakuwa thabiti wala waaminifu,"},{"verse":58,"text":"Wakamkasirisha Mungu kwa mahali pao pa juu pa kuabudia miungu,"},{"verse":59,"text":"Wakati Mungu alipowasikia, alikasirika sana,"},{"verse":60,"text":"Akaiacha hema ya Shilo,"},{"verse":61,"text":"Akalipeleka Sanduku la nguvu zake utumwani,"},{"verse":62,"text":"Aliachia watu wake wauawe kwa upanga,"},{"verse":63,"text":"Moto uliwaangamiza vijana wao,"},{"verse":64,"text":"makuhani wao waliuawa kwa upanga,"},{"verse":65,"text":"Ndipo Bwana alipoamka kama vile kuamka usingizini,"},{"verse":66,"text":"Aliwapiga na kuwashinda adui zake,"},{"verse":67,"text":"Ndipo alipozikataa hema za Yosefu,"},{"verse":68,"text":"lakini alilichagua kabila la Yuda,"},{"verse":69,"text":"Alijenga patakatifu pake kama vilele,"},{"verse":70,"text":"Akamchagua Daudi mtumishi wake"},{"verse":71,"text":"Kutoka kuchunga kondoo alimleta"},{"verse":72,"text":"Naye Daudi aliwachunga kwa uadilifu wa moyo,"}]}