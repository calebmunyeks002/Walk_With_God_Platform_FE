{"verses":[{"verse":1,"text":"Mungu anaongoza kusanyiko kuu,"},{"verse":2,"text":"“Hata lini utaendelea kuwatetea wasio haki"},{"verse":3,"text":"Teteeni wanyonge na yatima,"},{"verse":4,"text":"Mwokoeni mnyonge na mhitaji,"},{"verse":5,"text":"“Hawajui lolote, hawaelewi lolote."},{"verse":6,"text":"“Nilisema, ‘Ninyi ni “miungu”;"},{"verse":7,"text":"Lakini mtakufa kama wanadamu wa kawaida;"},{"verse":8,"text":"Ee Mungu, inuka uihukumu nchi,"}]}