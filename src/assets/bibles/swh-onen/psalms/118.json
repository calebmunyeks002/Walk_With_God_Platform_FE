{"verses":[{"verse":1,"text":"Mshukuruni \\nd Bwana\\nd*, kwa kuwa ni mwema;"},{"verse":2,"text":"Israeli na aseme sasa:"},{"verse":3,"text":"Nyumba ya Aroni na iseme sasa:"},{"verse":4,"text":"Wote wamchao \\nd Bwana\\nd* na waseme sasa:"},{"verse":5,"text":"Wakati wa maumivu yangu makuu nilimlilia \\nd Bwana\\nd*,"},{"verse":6,"text":"\\nd Bwana\\nd* yuko pamoja nami, sitaogopa."},{"verse":7,"text":"\\nd Bwana\\nd* yuko pamoja nami,"},{"verse":8,"text":"Ni bora kumkimbilia \\nd Bwana\\nd*"},{"verse":9,"text":"Ni bora kumkimbilia \\nd Bwana\\nd*"},{"verse":10,"text":"Mataifa yote yalinizunguka,"},{"verse":11,"text":"Walinizunguka pande zote,"},{"verse":12,"text":"Walinizunguka kama kundi la nyuki,"},{"verse":13,"text":"Nilisukumwa nyuma karibu kuanguka,"},{"verse":14,"text":"\\nd Bwana\\nd* ni nguvu yangu na wimbo wangu,"},{"verse":15,"text":"Sauti za shangwe na ushindi"},{"verse":16,"text":"Mkono wa kuume wa \\nd Bwana\\nd*"},{"verse":17,"text":"Sitakufa, bali nitaishi,"},{"verse":18,"text":"\\nd Bwana\\nd* ameniadhibu vikali,"},{"verse":19,"text":"Nifungulie malango ya haki,"},{"verse":20,"text":"Hili ni lango la \\nd Bwana\\nd*"},{"verse":21,"text":"Nitakushukuru, kwa kuwa ulinijibu,"},{"verse":22,"text":"Jiwe walilolikataa waashi,"},{"verse":23,"text":"\\nd Bwana\\nd* ametenda hili,"},{"verse":24,"text":"Hii ndiyo siku \\nd Bwana\\nd* aliyoifanya,"},{"verse":25,"text":"Ee \\nd Bwana\\nd*, tuokoe,"},{"verse":26,"text":"Heri yule ajaye kwa jina la \\nd Bwana\\nd*."},{"verse":27,"text":"\\nd Bwana\\nd* ndiye Mungu,"},{"verse":28,"text":"Wewe ni Mungu wangu, nitakushukuru,"},{"verse":29,"text":"Mshukuruni \\nd Bwana\\nd* kwa kuwa ni mwema;"}]}