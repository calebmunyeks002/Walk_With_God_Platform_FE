{"verses":[{"verse":1,"text":"Namlilia \\nd Bwana\\nd* kwa sauti,"},{"verse":2,"text":"Namimina malalamiko yangu mbele zake,"},{"verse":3,"text":"Wakati roho yangu inapozimia ndani yangu,"},{"verse":4,"text":"Tazama kuume kwangu na uone,"},{"verse":5,"text":"Ee \\nd Bwana\\nd*, nakulilia wewe,"},{"verse":6,"text":"Sikiliza kilio changu,"},{"verse":7,"text":"Nifungue kutoka kifungo changu,"}]}