{"verses":[{"verse":1,"text":"Msifuni \\nd Bwana\\nd*."},{"verse":2,"text":"Msifuni kwa matendo yake makuu,"},{"verse":3,"text":"Msifuni kwa mvumo wa tarumbeta,"},{"verse":4,"text":"msifuni kwa matari na kucheza,"},{"verse":5,"text":"msifuni kwa matoazi yaliayo,"},{"verse":6,"text":"Kila chenye pumzi na kimsifu \\nd Bwana\\nd*."}]}