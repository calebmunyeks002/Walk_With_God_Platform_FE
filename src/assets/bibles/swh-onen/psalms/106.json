{"verses":[{"verse":1,"text":"Msifuni \\nd Bwana\\nd*."},{"verse":2,"text":"Ni nani awezaye kusimulia matendo makuu ya \\nd Bwana\\nd*"},{"verse":3,"text":"Heri wale wanaodumisha haki,"},{"verse":4,"text":"Ee \\nd Bwana\\nd*, unikumbuke unapowatendea mema watu wako,"},{"verse":5,"text":"ili niweze kufurahia mafanikio ya wateule wako,"},{"verse":6,"text":"Tumetenda dhambi, kama vile baba zetu walivyotenda,"},{"verse":7,"text":"Wakati baba zetu walipokuwa Misri,"},{"verse":8,"text":"Hata hivyo aliwaokoa kwa ajili ya jina lake,"},{"verse":9,"text":"Alikemea Bahari ya Shamu, nayo ikakauka,"},{"verse":10,"text":"Aliwaokoa mikononi mwa adui;"},{"verse":11,"text":"Maji yaliwafunika adui zao,"},{"verse":12,"text":"Ndipo walipoamini ahadi zake,"},{"verse":13,"text":"Lakini mara walisahau aliyowatendea,"},{"verse":14,"text":"Jangwani walitawaliwa na tamaa zao,"},{"verse":15,"text":"Kwa hiyo aliwapa kile walichoomba,"},{"verse":16,"text":"Kambini walimwonea wivu Mose,"},{"verse":17,"text":"Ardhi ilifunguka ikawameza Dathani,"},{"verse":18,"text":"Moto uliwaka katikati ya wafuasi wao,"},{"verse":19,"text":"Huko Horebu walitengeneza ndama,"},{"verse":20,"text":"Waliubadilisha Utukufu wao"},{"verse":21,"text":"Walimsahau Mungu aliyewaokoa,"},{"verse":22,"text":"miujiza katika nchi ya Hamu"},{"verse":23,"text":"Kwa hiyo alisema kwamba angewaangamiza:"},{"verse":24,"text":"Kisha waliidharau ile nchi nzuri,"},{"verse":25,"text":"Walinungʼunika ndani ya mahema yao,"},{"verse":26,"text":"Kwa hiyo akaapa kwa mkono ulioinuliwa"},{"verse":27,"text":"kuwatawanya wazao wao waanguke miongoni mwa mataifa,"},{"verse":28,"text":"Walijifunga nira na Baali wa Peori,"},{"verse":29,"text":"Waliichochea hasira ya \\nd Bwana\\nd*,"},{"verse":30,"text":"Lakini Finehasi alisimama na kuingilia kati,"},{"verse":31,"text":"Hili likahesabiwa kwake haki,"},{"verse":32,"text":"Kwenye maji ya Meriba, walimkasirisha \\nd Bwana\\nd*,"},{"verse":33,"text":"kwa maana walimwasi Roho wa Mungu,"},{"verse":34,"text":"Hawakuyaangamiza yale mataifa"},{"verse":35,"text":"bali walijichanganya na mataifa"},{"verse":36,"text":"Waliabudu sanamu zao,"},{"verse":37,"text":"Wakawatoa wana wao"},{"verse":38,"text":"Walimwaga damu isiyo na hatia,"},{"verse":39,"text":"Wakajinajisi wenyewe kwa yale waliyotenda;"},{"verse":40,"text":"Kwa hiyo \\nd Bwana\\nd* akawakasirikia watu wake"},{"verse":41,"text":"Akawakabidhi kwa mataifa"},{"verse":42,"text":"Adui zao wakawaonea"},{"verse":43,"text":"Mara nyingi aliwaokoa"},{"verse":44,"text":"Lakini akaangalia mateso yao"},{"verse":45,"text":"kwa ajili yao akakumbuka agano lake,"},{"verse":46,"text":"Akawafanya wahurumiwe"},{"verse":47,"text":"Ee \\nd Bwana\\nd* Mungu wetu, tuokoe."},{"verse":48,"text":"Atukuzwe \\nd Bwana\\nd*, Mungu wa Israeli,"}]}