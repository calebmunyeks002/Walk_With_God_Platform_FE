{"verses":[{"verse":1,"text":"Heri mtu yule ambaye amesamehewa makosa yake,"},{"verse":2,"text":"Heri mtu yule ambaye \\nd Bwana\\nd*"},{"verse":3,"text":"Niliponyamaza, mifupa yangu ilichakaa"},{"verse":4,"text":"Usiku na mchana"},{"verse":5,"text":"Kisha nilikujulisha dhambi yangu"},{"verse":6,"text":"Kwa hiyo kila mtu mcha Mungu akuombe"},{"verse":7,"text":"Wewe ndiwe mahali pangu pa kujificha,"},{"verse":8,"text":"Nitakufundisha na kukuonyesha njia utakayoiendea;"},{"verse":9,"text":"Usiwe kama farasi au nyumbu"},{"verse":10,"text":"Mtu mwovu ana taabu nyingi,"},{"verse":11,"text":"Shangilieni katika \\nd Bwana\\nd* na mfurahi, enyi wenye haki!"}]}