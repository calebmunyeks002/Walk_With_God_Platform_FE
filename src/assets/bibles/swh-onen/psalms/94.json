{"verses":[{"verse":1,"text":"Ee \\nd Bwana\\nd*, ulipizaye kisasi,"},{"verse":2,"text":"Ee Mhukumu wa dunia, inuka,"},{"verse":3,"text":"Hata lini, waovu, Ee \\nd Bwana\\nd*,"},{"verse":4,"text":"Wanamimina maneno ya kiburi,"},{"verse":5,"text":"Ee \\nd Bwana\\nd*, wanawaponda watu wako,"},{"verse":6,"text":"Wanamchinja mjane na mgeni,"},{"verse":7,"text":"Nao husema, “\\nd Bwana\\nd* haoni,"},{"verse":8,"text":"Sikizeni, enyi wajinga miongoni mwa watu;"},{"verse":9,"text":"Je, aliyeweka sikio asisikie?"},{"verse":10,"text":"Je, anayeadhibisha mataifa asiadhibu?"},{"verse":11,"text":"\\nd Bwana\\nd* anajua mawazo ya mwanadamu;"},{"verse":12,"text":"Ee \\nd Bwana\\nd*, heri mtu anayeadhibishwa na wewe,"},{"verse":13,"text":"unampa utulivu siku za shida,"},{"verse":14,"text":"Kwa kuwa \\nd Bwana\\nd* hatawakataa watu wake,"},{"verse":15,"text":"Hukumu itasimamishwa tena kwenye haki,"},{"verse":16,"text":"Ni nani atakayeinuka dhidi ya mwovu kwa ajili yangu?"},{"verse":17,"text":"Kama \\nd Bwana\\nd* asingelinisaidia upesi,"},{"verse":18,"text":"Niliposema, “Mguu wangu unateleza,”"},{"verse":19,"text":"Wakati wasiwasi ulipokuwa mwingi ndani yangu,"},{"verse":20,"text":"Je, kiti cha utawala wa udhalimu kitajiunga nawe,"},{"verse":21,"text":"Huungana kuwashambulia wenye haki,"},{"verse":22,"text":"Lakini \\nd Bwana\\nd* amekuwa ngome yangu,"},{"verse":23,"text":"Yeye atawalipa kwa ajili ya dhambi zao"}]}