{"verses":[{"verse":1,"text":"Ninampenda \\nd Bwana\\nd* kwa maana amesikia sauti yangu;"},{"verse":2,"text":"Kwa sababu amenitegea sikio lake,"},{"verse":3,"text":"Kamba za mauti zilinizunguka,"},{"verse":4,"text":"Ndipo nikaliitia jina la \\nd Bwana\\nd*:"},{"verse":5,"text":"\\nd Bwana\\nd* ni mwenye neema na haki,"},{"verse":6,"text":"\\nd Bwana\\nd* huwalinda wanyenyekevu,"},{"verse":7,"text":"Ee nafsi yangu, tulia tena,"},{"verse":8,"text":"Kwa kuwa wewe, Ee \\nd Bwana\\nd*,"},{"verse":9,"text":"ili niweze kutembea mbele za \\nd Bwana\\nd*,"},{"verse":10,"text":"Niliamini, kwa hiyo nilisema,"},{"verse":11,"text":"Katika taabu yangu nilisema,"},{"verse":12,"text":"Nimrudishie \\nd Bwana\\nd* nini"},{"verse":13,"text":"Nitakiinua kikombe cha wokovu"},{"verse":14,"text":"Nitazitimiza nadhiri zangu kwa \\nd Bwana\\nd*"},{"verse":15,"text":"Kifo cha watakatifu kina thamani"},{"verse":16,"text":"Ee \\nd Bwana\\nd*, hakika mimi ni mtumishi wako,"},{"verse":17,"text":"Nitakutolea dhabihu ya kukushukuru"},{"verse":18,"text":"Nitazitimiza nadhiri zangu kwa \\nd Bwana\\nd*"},{"verse":19,"text":"katika nyua za nyumba ya \\nd Bwana\\nd*,"}]}