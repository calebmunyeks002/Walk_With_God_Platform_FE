{"verses":[{"verse":1,"text":"\\nd Bwana\\nd* alipowarejeza mateka Sayuni,"},{"verse":2,"text":"Vinywa vyetu vilijaa kicheko,"},{"verse":3,"text":"\\nd Bwana\\nd* ametutendea mambo makuu,"},{"verse":4,"text":"Ee \\nd Bwana\\nd*, turejeshee watu wetu waliotekwa,"},{"verse":5,"text":"Wapandao kwa machozi"},{"verse":6,"text":"Yeye azichukuaye mbegu zake"}]}