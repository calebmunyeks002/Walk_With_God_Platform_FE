{"verses":[{"verse":1,"text":"\\nd Bwana\\nd* ni mkuu, anayestahili kusifiwa sana,"},{"verse":2,"text":"Ni mzuri katika kuinuka kwake juu sana,"},{"verse":3,"text":"Mungu yuko katika ngome zake;"},{"verse":4,"text":"Wakati wafalme walipounganisha nguvu,"},{"verse":5,"text":"walimwona nao wakashangaa,"},{"verse":6,"text":"Kutetemeka kuliwashika huko,"},{"verse":7,"text":"Uliwaangamiza kama meli za Tarshishi"},{"verse":8,"text":"Kama tulivyokuwa tumesikia,"},{"verse":9,"text":"Ee Mungu, hekaluni mwako"},{"verse":10,"text":"Ee Mungu, kama jina lako lilivyo,"},{"verse":11,"text":"Mlima Sayuni unashangilia,"},{"verse":12,"text":"Tembeeni katika Sayuni,"},{"verse":13,"text":"yatafakarini vyema maboma yake,"},{"verse":14,"text":"Kwa kuwa huyu Mungu ni Mungu wetu milele na milele;"}]}