{"verses":[{"verse":1,"text":"Mshukuruni \\nd Bwana\\nd*, liitieni jina lake,"},{"verse":2,"text":"Mwimbieni yeye, mwimbieni yeye sifa,"},{"verse":3,"text":"Lishangilieni jina lake takatifu,"},{"verse":4,"text":"Mtafuteni \\nd Bwana\\nd* na nguvu zake,"},{"verse":5,"text":"Kumbuka matendo ya ajabu aliyoyafanya,"},{"verse":6,"text":"enyi wazao wa Abrahamu mtumishi wake,"},{"verse":7,"text":"Yeye ndiye \\nd Bwana\\nd* Mungu wetu,"},{"verse":8,"text":"Hulikumbuka agano lake milele,"},{"verse":9,"text":"agano alilolifanya na Abrahamu,"},{"verse":10,"text":"Alilithibitisha kwa Yakobo kuwa amri,"},{"verse":11,"text":"“Nitakupa wewe nchi ya Kanaani"},{"verse":12,"text":"Walipokuwa wachache kwa idadi,"},{"verse":13,"text":"walitangatanga kutoka taifa moja hadi jingine,"},{"verse":14,"text":"Hakuruhusu mtu yeyote awaonee;"},{"verse":15,"text":"“Msiwaguse niliowatia mafuta;"},{"verse":16,"text":"Akaiita njaa juu ya nchi"},{"verse":17,"text":"naye akatuma mtu mbele yao,"},{"verse":18,"text":"Walichubua miguu yake kwa minyororo,"},{"verse":19,"text":"hadi yale aliyotangulia kusema yalipotimia,"},{"verse":20,"text":"Mfalme alituma watu wakamfungua,"},{"verse":21,"text":"Alimfanya mkuu wa nyumba yake,"},{"verse":22,"text":"kuwaelekeza wakuu wa mfalme apendavyo"},{"verse":23,"text":"Kisha Israeli akaingia Misri,"},{"verse":24,"text":"\\nd Bwana\\nd* aliwafanya watu wake kuzaana sana,"},{"verse":25,"text":"ndiye aliigeuza mioyo yao iwachukie watu wake,"},{"verse":26,"text":"Akamtuma Mose mtumishi wake,"},{"verse":27,"text":"Walifanya ishara zake za ajabu miongoni mwao,"},{"verse":28,"text":"Alituma giza na nchi ikajaa giza,"},{"verse":29,"text":"Aligeuza maji yao kuwa damu,"},{"verse":30,"text":"Nchi yao ilijaa vyura tele, ambao waliingia"},{"verse":31,"text":"Alisema, yakaja makundi ya mainzi,"},{"verse":32,"text":"Alibadilisha mvua yao ikawa mvua ya mawe,"},{"verse":33,"text":"akaharibu mizabibu yao na miti ya tini,"},{"verse":34,"text":"Alisema, nzige wakaja,"},{"verse":35,"text":"wakala kila jani katika nchi yao,"},{"verse":36,"text":"Kisha akawaua wazaliwa wote wa kwanza katika nchi yao,"},{"verse":37,"text":"Akawatoa Israeli katika nchi"},{"verse":38,"text":"Misri ilifurahi walipoondoka,"},{"verse":39,"text":"Alitandaza wingu kama kifuniko,"},{"verse":40,"text":"Waliomba, naye akawaletea kware,"},{"verse":41,"text":"Alipasua mwamba, maji yakabubujika,"},{"verse":42,"text":"Kwa maana alikumbuka ahadi yake takatifu,"},{"verse":43,"text":"Aliwatoa watu wake kwa furaha,"},{"verse":44,"text":"akawapa nchi za mataifa, wakawa warithi"},{"verse":45,"text":"alifanya haya ili wayashike mausia yake"}]}