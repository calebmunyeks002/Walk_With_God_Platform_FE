{"verses":[{"verse":1,"text":"Ee nafsi yangu, umhimidi \\nd Bwana\\nd*."},{"verse":2,"text":"Amejifunika katika nuru kama vile kwa vazi,"},{"verse":3,"text":"na kuziweka nguzo za orofa yake juu ya maji."},{"verse":4,"text":"Huzifanya pepo kuwa wajumbe\\f + \\fr 104:4 \\ft Au: malaika.\\f* wake,"},{"verse":5,"text":"Ameiweka dunia kwenye misingi yake,"},{"verse":6,"text":"Uliifunika kwa kilindi kama kwa vazi,"},{"verse":7,"text":"Lakini kwa kukemea kwako maji yalikimbia,"},{"verse":8,"text":"yakapanda milima, yakateremka mabondeni,"},{"verse":9,"text":"Uliyawekea mpaka ambao hayawezi kuuvuka,"},{"verse":10,"text":"Huzifanya chemchemi zimwage maji mabondeni,"},{"verse":11,"text":"Huwapa maji wanyama wote wa kondeni,"},{"verse":12,"text":"Ndege wa angani hufanya viota kando ya maji,"},{"verse":13,"text":"Huinyeshea milima kutoka orofa zake,"},{"verse":14,"text":"Huyafanya majani ya mifugo yaote,"},{"verse":15,"text":"divai ya kuufurahisha moyo wa mwanadamu,"},{"verse":16,"text":"Miti ya \\nd Bwana\\nd* inanyeshewa vizuri,"},{"verse":17,"text":"Humo ndege hufanya viota vyao,"},{"verse":18,"text":"Milima mirefu ni makao ya mbuzi-mwitu,"},{"verse":19,"text":"Mwezi hugawanya majira,"},{"verse":20,"text":"Unaleta giza, kunakuwa usiku,"},{"verse":21,"text":"Simba hunguruma kwa mawindo yao,"},{"verse":22,"text":"Jua huchomoza, nao huondoka,"},{"verse":23,"text":"Kisha mwanadamu huenda kazini mwake,"},{"verse":24,"text":"Ee \\nd Bwana\\nd*, jinsi matendo yako yalivyo mengi!"},{"verse":25,"text":"Pale kuna bahari, kubwa na yenye nafasi tele,"},{"verse":26,"text":"Huko meli huenda na kurudi,"},{"verse":27,"text":"Hawa wote wanakutazamia wewe,"},{"verse":28,"text":"Wakati unapowapa,"},{"verse":29,"text":"Unapoficha uso wako,"},{"verse":30,"text":"Unapopeleka Roho wako,"},{"verse":31,"text":"Utukufu wa \\nd Bwana\\nd* na udumu milele,"},{"verse":32,"text":"yeye aitazamaye dunia, nayo ikatetemeka,"},{"verse":33,"text":"Nitamwimbia \\nd Bwana\\nd* maisha yangu yote;"},{"verse":34,"text":"Kutafakari kwangu na kumpendeze yeye,"},{"verse":35,"text":"Lakini wenye dhambi na watoweke katika dunia"}]}