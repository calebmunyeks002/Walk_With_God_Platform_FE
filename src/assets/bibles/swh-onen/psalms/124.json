{"verses":[{"verse":1,"text":"Kama \\nd Bwana\\nd* asingalikuwa upande wetu;"},{"verse":2,"text":"kama \\nd Bwana\\nd* asingalikuwa upande wetu,"},{"verse":3,"text":"wakati hasira yao ilipowaka dhidi yetu,"},{"verse":4,"text":"mafuriko yangalitugharikisha,"},{"verse":5,"text":"maji yaendayo kasi"},{"verse":6,"text":"\\nd Bwana\\nd* asifiwe,"},{"verse":7,"text":"Tumeponyoka kama ndege"},{"verse":8,"text":"Msaada wetu ni katika jina la \\nd Bwana\\nd*,"}]}