{"verses":[{"verse":1,"text":"Mshukuruni \\nd Bwana\\nd*, kwa kuwa ni mwema."},{"verse":2,"text":"Mshukuruni Mungu wa miungu."},{"verse":3,"text":"Mshukuruni Bwana wa mabwana:"},{"verse":4,"text":"Kwake yeye pekee atendaye maajabu makuu,"},{"verse":5,"text":"Ambaye kwa ufahamu wake aliziumba mbingu,"},{"verse":6,"text":"Ambaye aliitandaza dunia juu ya maji,"},{"verse":7,"text":"Ambaye aliumba mianga mikubwa,"},{"verse":8,"text":"Jua litawale mchana,"},{"verse":9,"text":"Mwezi na nyota vitawale usiku,"},{"verse":10,"text":"Kwake yeye aliyemuua mzaliwa wa kwanza wa Misri,"},{"verse":11,"text":"Na kuwatoa Israeli katikati yao,"},{"verse":12,"text":"Kwa mkono wenye nguvu ulionyooshwa,"},{"verse":13,"text":"Kwake yeye aliyeigawa Bahari ya Shamu,"},{"verse":14,"text":"Na kuwapitisha Israeli katikati yake,"},{"verse":15,"text":"Lakini alimfagia Farao na jeshi lake katika Bahari ya Shamu,"},{"verse":16,"text":"Kwake yeye aliyewaongoza watu wake katika jangwa,"},{"verse":17,"text":"Ambaye aliwapiga wafalme wenye nguvu,"},{"verse":18,"text":"Naye aliwaua wafalme wenye nguvu,"},{"verse":19,"text":"Sihoni mfalme wa Waamori,"},{"verse":20,"text":"Ogu mfalme wa Bashani,"},{"verse":21,"text":"Akatoa nchi yao kuwa urithi,"},{"verse":22,"text":"Urithi kwa Israeli mtumishi wake,"},{"verse":23,"text":"Aliyetukumbuka katika unyonge wetu,"},{"verse":24,"text":"Alituweka huru toka adui zetu,"},{"verse":25,"text":"Ambaye humpa chakula kila kiumbe."},{"verse":26,"text":"Mshukuruni Mungu wa mbinguni,"}]}