{"verses":[{"verse":1,"text":"Nitamtukuza \\nd Bwana\\nd* nyakati zote,"},{"verse":2,"text":"Nafsi yangu itajisifu katika \\nd Bwana\\nd*,"},{"verse":3,"text":"Mtukuzeni \\nd Bwana\\nd* pamoja nami,"},{"verse":4,"text":"Nilimtafuta \\nd Bwana\\nd* naye akanijibu,"},{"verse":5,"text":"Wale wamtazamao hutiwa nuru,"},{"verse":6,"text":"Maskini huyu alimwita \\nd Bwana\\nd*, naye akamsikia,"},{"verse":7,"text":"Malaika wa \\nd Bwana\\nd* hufanya kituo"},{"verse":8,"text":"Onjeni mwone kwamba \\nd Bwana\\nd* ni mwema,"},{"verse":9,"text":"Mcheni \\nd Bwana\\nd* enyi watakatifu wake,"},{"verse":10,"text":"Wana simba wenye nguvu"},{"verse":11,"text":"Njooni, watoto wangu, mnisikilize,"},{"verse":12,"text":"Yeyote kati yenu anayependa uzima"},{"verse":13,"text":"basi auzuie ulimi wake na mabaya,"},{"verse":14,"text":"Aache uovu, atende mema,"},{"verse":15,"text":"Macho ya \\nd Bwana\\nd* huwaelekea wenye haki,"},{"verse":16,"text":"Uso wa \\nd Bwana\\nd* uko kinyume na watendao maovu,"},{"verse":17,"text":"Wenye haki hulia, naye \\nd Bwana\\nd* huwasikia,"},{"verse":18,"text":"\\nd Bwana\\nd* yu karibu na waliovunjika moyo,"},{"verse":19,"text":"Mwenye haki ana mateso mengi,"},{"verse":20,"text":"huhifadhi mifupa yake yote,"},{"verse":21,"text":"Ubaya utamuua mtu mwovu,"},{"verse":22,"text":"\\nd Bwana\\nd* huwakomboa watumishi wake,"}]}