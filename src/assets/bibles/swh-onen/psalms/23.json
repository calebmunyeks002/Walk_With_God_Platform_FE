{"verses":[{"verse":1,"text":"\\nd Bwana\\nd* ndiye mchungaji wangu,"},{"verse":2,"text":"Hunilaza katika malisho"},{"verse":3,"text":"hunihuisha nafsi yangu."},{"verse":4,"text":"Hata kama nikipita katikati"},{"verse":5,"text":"Waandaa meza mbele yangu"},{"verse":6,"text":"Hakika wema na upendo vitanifuata"}]}