{"verses":[{"verse":1,"text":"Mpumbavu anasema moyoni mwake,"},{"verse":2,"text":"\\nd Bwana\\nd* anawachungulia wanadamu chini"},{"verse":3,"text":"Wote wamepotoka,"},{"verse":4,"text":"Je, watendao mabaya kamwe hawatajifunza:"},{"verse":5,"text":"Wako hapo, wameingiwa na hofu kuu,"},{"verse":6,"text":"Ninyi watenda mabaya mnakwamisha mipango ya maskini,"},{"verse":7,"text":"Laiti wokovu wa Israeli"}]}