{"verses":[{"verse":1,"text":"Wamenionea mno tangu ujana wangu;"},{"verse":2,"text":"wamenionea mno tangu ujana wangu,"},{"verse":3,"text":"Wakulima wamelima mgongo wangu,"},{"verse":4,"text":"Lakini \\nd Bwana\\nd* ni mwenye haki;"},{"verse":5,"text":"Wale wote waichukiao Sayuni"},{"verse":6,"text":"Wawe kama majani juu ya paa,"},{"verse":7,"text":"kwa hayo mvunaji hawezi kujaza vitanga vyake,"},{"verse":8,"text":"Wale wapitao karibu na wasiseme,"}]}