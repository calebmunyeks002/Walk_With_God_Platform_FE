{"verses":[{"verse":1,"text":"Msifuni \\nd Bwana\\nd*!\\f + \\fr 146:1 \\ft Msifuni \\+nd Bwana\\+nd* kwa Kiebrania ni Hallelu Yah.\\f*"},{"verse":2,"text":"Nitamsifu \\nd Bwana\\nd* maisha yangu yote;"},{"verse":3,"text":"Usiweke tumaini lako kwa wakuu,"},{"verse":4,"text":"Roho yao itokapo hurudi mavumbini,"},{"verse":5,"text":"Heri yeye ambaye Mungu wa Yakobo ni msaada wake,"},{"verse":6,"text":"Muumba wa mbingu na nchi,"},{"verse":7,"text":"Naye huwapatia haki walioonewa"},{"verse":8,"text":"\\nd Bwana\\nd* huwafumbua vipofu macho,"},{"verse":9,"text":"\\nd Bwana\\nd* huwalinda wageni"},{"verse":10,"text":"\\nd Bwana\\nd* atamiliki milele,"}]}