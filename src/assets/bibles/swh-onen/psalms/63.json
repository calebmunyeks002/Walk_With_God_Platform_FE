{"verses":[{"verse":1,"text":"Ee Mungu, wewe ni Mungu wangu,"},{"verse":2,"text":"Nimekuona katika mahali patakatifu"},{"verse":3,"text":"Kwa sababu upendo wako ni bora kuliko uhai,"},{"verse":4,"text":"Nitakusifu siku zote za maisha yangu,"},{"verse":5,"text":"Nafsi yangu itatoshelezwa"},{"verse":6,"text":"Kitandani mwangu ninakukumbuka wewe,"},{"verse":7,"text":"Kwa sababu wewe ndiwe msaada wangu,"},{"verse":8,"text":"Nafsi yangu inaambatana nawe,"},{"verse":9,"text":"Wale wanaotafuta uhai wangu wataharibiwa,"},{"verse":10,"text":"Watatolewa wafe kwa upanga,"},{"verse":11,"text":"Bali mfalme atafurahi katika Mungu,"}]}