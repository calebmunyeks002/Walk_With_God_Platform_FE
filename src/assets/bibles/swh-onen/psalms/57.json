{"verses":[{"verse":1,"text":"Unihurumie, Ee Mungu, unihurumie,"},{"verse":2,"text":"Namlilia Mungu Aliye Juu Sana,"},{"verse":3,"text":"Hutumana kutoka mbinguni na kuniokoa,"},{"verse":4,"text":"Niko katikati ya simba,"},{"verse":5,"text":"Ee Mungu, utukuzwe juu ya mbingu,"},{"verse":6,"text":"Waliitegea miguu yangu nyavu,"},{"verse":7,"text":"Ee Mungu, moyo wangu ni thabiti;"},{"verse":8,"text":"Amka, nafsi yangu!"},{"verse":9,"text":"Nitakusifu wewe, Ee \\nd Bwana\\nd*, katikati ya mataifa;"},{"verse":10,"text":"Kwa maana upendo wako ni mkuu, waenea hadi mbinguni,"},{"verse":11,"text":"Ee Mungu, utukuzwe juu mbinguni,"}]}