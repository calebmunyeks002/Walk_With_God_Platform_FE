{"verses":[{"verse":1,"text":"Ee Mungu unihurumie, maana watu wananifuatia vikali;"},{"verse":2,"text":"Wasingiziaji wangu wananifuatia mchana kutwa,"},{"verse":3,"text":"Wakati ninapoogopa,"},{"verse":4,"text":"Katika Mungu, ambaye neno lake ninalisifu,"},{"verse":5,"text":"Mchana kutwa wanayageuza maneno yangu,"},{"verse":6,"text":"Wananifanyia hila, wanajificha,"},{"verse":7,"text":"Wasiepuke kwa vyovyote,"},{"verse":8,"text":"Andika maombolezo yangu,"},{"verse":9,"text":"Ndipo adui zangu watarudi nyuma"},{"verse":10,"text":"Katika Mungu, ambaye neno lake ninalisifu,"},{"verse":11,"text":"katika Mungu ninatumaini, sitaogopa."},{"verse":12,"text":"Ee Mungu, nina nadhiri kwako,"},{"verse":13,"text":"Kwa kuwa umeniokoa toka kwenye mauti"}]}