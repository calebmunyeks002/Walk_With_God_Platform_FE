{"verses":[{"verse":1,"text":"Heri mtu yule ambaye"},{"verse":2,"text":"Bali huifurahia sheria ya \\nd Bwana\\nd*,"},{"verse":3,"text":"Mtu huyo ni kama mti uliopandwa"},{"verse":4,"text":"Sivyo walivyo waovu!"},{"verse":5,"text":"Kwa hiyo waovu hawatastahimili hukumu,"},{"verse":6,"text":"Kwa maana \\nd Bwana\\nd* huziangalia njia za mwenye haki,"}]}