{"verses":[{"verse":1,"text":"Mpigieni Mungu kelele za shangwe, dunia yote!"},{"verse":2,"text":"Imbeni utukufu wa jina lake;"},{"verse":3,"text":"Mwambieni Mungu, “Jinsi gani yalivyo ya kutisha matendo yako!"},{"verse":4,"text":"Dunia yote yakusujudia,"},{"verse":5,"text":"Njooni mwone yale Mungu aliyoyatenda,"},{"verse":6,"text":"Alifanya bahari kuwa nchi kavu,"},{"verse":7,"text":"Yeye hutawala kwa uwezo wake milele,"},{"verse":8,"text":"Enyi mataifa, msifuni Mungu wetu,"},{"verse":9,"text":"ameyahifadhi maisha yetu"},{"verse":10,"text":"Ee Mungu, wewe ulitujaribu,"},{"verse":11,"text":"Umetuingiza kwenye nyavu"},{"verse":12,"text":"Uliwaruhusu watu watukalie vichwani,"},{"verse":13,"text":"Nitakuja hekaluni mwako na sadaka za kuteketezwa"},{"verse":14,"text":"nadhiri ambazo midomo yangu iliahidi"},{"verse":15,"text":"Nitakutolea dhabihu za wanyama wanono"},{"verse":16,"text":"Njooni msikilize ninyi nyote mnaomcha Mungu,"},{"verse":17,"text":"Nilimlilia kwa kinywa changu,"},{"verse":18,"text":"Kama ningekuwa nimeyaficha maovu moyoni mwangu,"},{"verse":19,"text":"lakini hakika Mungu amenisikiliza"},{"verse":20,"text":"Sifa apewe Mungu,"}]}