{"verses":[{"verse":1,"text":"\\nd Bwana\\nd* na akujibu unapokuwa katika dhiki,"},{"verse":2,"text":"Na akutumie msaada kutoka patakatifu"},{"verse":3,"text":"Na azikumbuke dhabihu zako zote,"},{"verse":4,"text":"Na akujalie haja ya moyo wako,"},{"verse":5,"text":"Tutashangilia kwa furaha utakaposhinda,"},{"verse":6,"text":"Sasa nafahamu kuwa \\nd Bwana\\nd*"},{"verse":7,"text":"Wengine wanatumaini magari ya vita, na wengine farasi,"},{"verse":8,"text":"Wao wameshushwa chini na kuanguka,"},{"verse":9,"text":"Ee \\nd Bwana\\nd*, mwokoe mfalme!"}]}