{"verses":[{"verse":1,"text":"Nitakutukuza wewe, Ee \\nd Bwana\\nd*,"},{"verse":2,"text":"Ee \\nd Bwana\\nd*, Mungu wangu, nilikuita unisaidie"},{"verse":3,"text":"Ee \\nd Bwana\\nd*, umenitoa Kuzimu,"},{"verse":4,"text":"Mwimbieni \\nd Bwana\\nd*, enyi watakatifu wake;"},{"verse":5,"text":"Kwa maana hasira yake ni ya muda mfupi,"},{"verse":6,"text":"Nilipofanikiwa nilisema,"},{"verse":7,"text":"Ee \\nd Bwana\\nd*, uliponijalia,"},{"verse":8,"text":"Kwako wewe, Ee \\nd Bwana\\nd*, niliita,"},{"verse":9,"text":"“Kuna faida gani katika kuangamia kwangu?"},{"verse":10,"text":"Ee \\nd Bwana\\nd*, unisikie na kunihurumia,"},{"verse":11,"text":"Uligeuza maombolezo yangu kuwa kucheza,"},{"verse":12,"text":"ili moyo wangu uweze kukusifu na usikae kimya."}]}