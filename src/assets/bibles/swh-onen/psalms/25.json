{"verses":[{"verse":1,"text":"Kwako wewe, Ee \\nd Bwana\\nd*,"},{"verse":2,"text":"ni wewe ninayekutumainia,"},{"verse":3,"text":"Kamwe hakuna hata mmoja anayekutegemea"},{"verse":4,"text":"Nionyeshe njia zako, Ee \\nd Bwana\\nd*,"},{"verse":5,"text":"niongoze katika kweli yako na kunifundisha,"},{"verse":6,"text":"Kumbuka, Ee \\nd Bwana\\nd*, rehema zako kuu na upendo,"},{"verse":7,"text":"Usizikumbuke dhambi za ujana wangu"},{"verse":8,"text":"\\nd Bwana\\nd* ni mwema na mwenye adili,"},{"verse":9,"text":"Huwaongoza wanyenyekevu katika haki,"},{"verse":10,"text":"Njia zote za \\nd Bwana\\nd* ni za upendo na uaminifu"},{"verse":11,"text":"Ee \\nd Bwana\\nd*, kwa ajili ya jina lako,"},{"verse":12,"text":"Ni nani basi, mtu yule anayemcha \\nd Bwana\\nd*?"},{"verse":13,"text":"Mtu huyo atafanikiwa maishani mwake,"},{"verse":14,"text":"Siri ya \\nd Bwana\\nd* iko kwa wale wamchao,"},{"verse":15,"text":"Macho yangu humwelekea \\nd Bwana\\nd* daima,"},{"verse":16,"text":"Nigeukie na unihurumie,"},{"verse":17,"text":"Shida za moyo wangu zimeongezeka,"},{"verse":18,"text":"Uangalie mateso na shida zangu"},{"verse":19,"text":"Tazama adui zangu walivyo wengi,"},{"verse":20,"text":"Uyalinde maisha yangu na uniokoe,"},{"verse":21,"text":"Uadilifu na uaminifu vinilinde,"},{"verse":22,"text":"Ee Mungu, wakomboe Israeli,"}]}