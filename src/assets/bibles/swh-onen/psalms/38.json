{"verses":[{"verse":1,"text":"Ee \\nd Bwana\\nd*, usinikemee katika hasira yako,"},{"verse":2,"text":"Kwa kuwa mishale yako imenichoma,"},{"verse":3,"text":"Hakuna afya mwilini mwangu"},{"verse":4,"text":"Maovu yangu yamenifunika"},{"verse":5,"text":"Majeraha yangu yameoza na yananuka,"},{"verse":6,"text":"Nimeinamishwa chini na kushushwa sana,"},{"verse":7,"text":"Viuno vyangu vimejaa maumivu yaunguzayo,"},{"verse":8,"text":"Nimedhoofika na kupondwa kabisa,"},{"verse":9,"text":"Ee \\nd Bwana\\nd*, yote ninayoyaonea shauku"},{"verse":10,"text":"Moyo wangu unapigapiga,"},{"verse":11,"text":"Rafiki na wenzangu wananikwepa"},{"verse":12,"text":"Wale wanaotafuta uhai wangu"},{"verse":13,"text":"Mimi ni kama mtu kiziwi, asiyeweza kusikia,"},{"verse":14,"text":"nimekuwa kama mtu asiyesikia,"},{"verse":15,"text":"Ee \\nd Bwana\\nd*, ninakungojea wewe,"},{"verse":16,"text":"Kwa kuwa nilisema, “Usiwaache wafurahie,"},{"verse":17,"text":"Kwa maana ninakaribia kuanguka,"},{"verse":18,"text":"Naungama uovu wangu,"},{"verse":19,"text":"Wengi ni wale ambao ni adui zangu hodari,"},{"verse":20,"text":"Wanaolipa maovu kwa wema wangu"},{"verse":21,"text":"Ee \\nd Bwana\\nd*, usiniache,"},{"verse":22,"text":"Ee Bwana Mwokozi wangu,"}]}