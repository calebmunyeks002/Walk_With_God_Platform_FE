{"verses":[{"verse":1,"text":"Ee Mungu, niokoe,"},{"verse":2,"text":"Ninazama kwenye vilindi vya matope,"},{"verse":3,"text":"Nimechoka kwa kuomba msaada,"},{"verse":4,"text":"Wale wanaonichukia bila sababu"},{"verse":5,"text":"Ee Mungu, wewe unajua upumbavu wangu,"},{"verse":6,"text":"Ee Bwana, ewe \\nd Bwana\\nd* Mwenye Nguvu Zote,"},{"verse":7,"text":"Kwa maana nimestahimili dharau kwa ajili yako,"},{"verse":8,"text":"Nimekuwa mgeni kwa ndugu zangu,"},{"verse":9,"text":"Kwa kuwa wivu wa nyumba yako unanila,"},{"verse":10,"text":"Ninapolia na kufunga,"},{"verse":11,"text":"Ninapovaa nguo ya gunia,"},{"verse":12,"text":"Wale wanaoketi mlangoni wananisimanga,"},{"verse":13,"text":"Lakini Ee \\nd Bwana\\nd*, ninakuomba,"},{"verse":14,"text":"Uniokoe katika matope,"},{"verse":15,"text":"Usiache mafuriko yanigharikishe"},{"verse":16,"text":"Ee \\nd Bwana\\nd*, unijibu, kwa wema wa upendo wako;"},{"verse":17,"text":"Usimfiche mtumishi wako uso wako,"},{"verse":18,"text":"Njoo karibu uniokoe,"},{"verse":19,"text":"Unajua jinsi ninavyodharauliwa,"},{"verse":20,"text":"Dharau zimenivunja moyo"},{"verse":21,"text":"Waliweka nyongo katika chakula changu"},{"verse":22,"text":"Meza iliyoandaliwa mbele yao na iwe mtego,"},{"verse":23,"text":"Macho yao yatiwe giza ili wasiweze kuona,"},{"verse":24,"text":"Uwamwagie ghadhabu yako,"},{"verse":25,"text":"Mahali pao na pawe ukiwa,"},{"verse":26,"text":"Kwa kuwa wanawatesa wale uliowajeruhi,"},{"verse":27,"text":"Walipize uovu juu ya uovu,"},{"verse":28,"text":"Wafutwe kutoka kitabu cha uzima"},{"verse":29,"text":"Mimi niko katika maumivu na dhiki;"},{"verse":30,"text":"Nitalisifu jina la Mungu kwa wimbo,"},{"verse":31,"text":"Hili litampendeza \\nd Bwana\\nd* kuliko ngʼombe dume,"},{"verse":32,"text":"Maskini wataona na kufurahi:"},{"verse":33,"text":"\\nd Bwana\\nd* huwasikia wahitaji"},{"verse":34,"text":"Mbingu na dunia zimsifu,"},{"verse":35,"text":"kwa maana Mungu ataiokoa Sayuni"},{"verse":36,"text":"watoto wa watumishi wake watairithi"}]}