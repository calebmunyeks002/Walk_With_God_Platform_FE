{"verses":[{"verse":1,"text":"Kando ya mito ya Babeli tuliketi, tukaomboleza"},{"verse":2,"text":"Kwenye miti ya huko"},{"verse":3,"text":"kwa maana huko hao waliotuteka"},{"verse":4,"text":"Tutaimbaje nyimbo za \\nd Bwana\\nd*,"},{"verse":5,"text":"Nikikusahau wewe, ee Yerusalemu,"},{"verse":6,"text":"Ulimi wangu ushikamane na kaakaa la kinywa changu"},{"verse":7,"text":"Kumbuka, Ee \\nd Bwana\\nd*, walichokifanya Waedomu,"},{"verse":8,"text":"Ee binti Babeli, uliyehukumiwa kuangamizwa,"},{"verse":9,"text":"yeye ambaye atawakamata watoto wako wachanga"}]}