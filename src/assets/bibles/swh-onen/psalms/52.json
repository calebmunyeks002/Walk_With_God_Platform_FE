{"verses":[{"verse":1,"text":"Ewe jitu, mbona unajivunia ubaya?"},{"verse":2,"text":"Ulimi wako hupanga mashauri mabaya ya maangamizi."},{"verse":3,"text":"Unapenda mabaya kuliko mema,"},{"verse":4,"text":"Unapenda kila neno lenye kudhuru,"},{"verse":5,"text":"Hakika Mungu atakushusha chini"},{"verse":6,"text":"Wenye haki wataona na kuogopa,"},{"verse":7,"text":"“Huyu ni yule mtu ambaye"},{"verse":8,"text":"Lakini mimi ni kama mti wa mzeituni"},{"verse":9,"text":"Nitakusifu milele kwa yale uliyoyatenda,"}]}