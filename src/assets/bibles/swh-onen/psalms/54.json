{"verses":[{"verse":1,"text":"Ee Mungu uniokoe kwa jina lako,"},{"verse":2,"text":"Ee Mungu, sikia maombi yangu,"},{"verse":3,"text":"Wageni wananishambulia,"},{"verse":4,"text":"Hakika Mungu ni msaada wangu,"},{"verse":5,"text":"Mabaya na yawarudie wale wanaonisingizia,"},{"verse":6,"text":"Nitakutolea dhabihu za hiari;"},{"verse":7,"text":"Kwa maana ameniokoa katika shida zangu zote,"}]}