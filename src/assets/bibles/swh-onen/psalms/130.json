{"verses":[{"verse":1,"text":"Kutoka vilindini ninakulilia, Ee \\nd Bwana\\nd*."},{"verse":2,"text":"Ee \\nd Bwana\\nd*, sikia sauti yangu."},{"verse":3,"text":"Kama wewe, Ee \\nd Bwana\\nd*, ungeweka kumbukumbu ya dhambi,"},{"verse":4,"text":"Lakini kwako kuna msamaha,"},{"verse":5,"text":"Namngojea \\nd Bwana\\nd*, nafsi yangu inangojea,"},{"verse":6,"text":"Nafsi yangu inamngojea Bwana"},{"verse":7,"text":"Ee Israeli, mtumaini \\nd Bwana\\nd*,"},{"verse":8,"text":"Yeye mwenyewe ataikomboa Israeli"}]}