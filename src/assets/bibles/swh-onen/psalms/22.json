{"verses":[{"verse":1,"text":"Mungu wangu, Mungu wangu, mbona umeniacha?"},{"verse":2,"text":"Ee Mungu wangu, ninalia mchana, lakini hunijibu,"},{"verse":3,"text":"Hata hivyo umesimikwa katika kiti cha enzi kama Uliye Mtakatifu;"},{"verse":4,"text":"Kwako wewe baba zetu waliweka tumaini lao,"},{"verse":5,"text":"Walikulilia wewe na ukawaokoa,"},{"verse":6,"text":"Mimi ni mnyoo wala si mwanadamu,"},{"verse":7,"text":"Wote wanionao hunidhihaki,"},{"verse":8,"text":"Husema, “Anamtegemea \\nd Bwana\\nd*,"},{"verse":9,"text":"Hata hivyo ulinitoa tumboni,"},{"verse":10,"text":"Nimekabidhiwa kwako tangu kuzaliwa,"},{"verse":11,"text":"Usiwe mbali nami,"},{"verse":12,"text":"Mafahali wengi wamenizunguka,"},{"verse":13,"text":"Simba wangurumao wanaorarua mawindo"},{"verse":14,"text":"Nimemiminwa kama maji,"},{"verse":15,"text":"Nguvu zangu zimekauka kama kigae,"},{"verse":16,"text":"Mbwa wamenizunguka,"},{"verse":17,"text":"Naweza kuhesabu mifupa yangu yote,"},{"verse":18,"text":"Wanagawana nguo zangu wao kwa wao,"},{"verse":19,"text":"Lakini wewe, Ee \\nd Bwana\\nd*,"},{"verse":20,"text":"Okoa maisha yangu na upanga,"},{"verse":21,"text":"Niokoe kutoka kinywani mwa simba,"},{"verse":22,"text":"Nitalitangaza jina lako kwa ndugu zangu,"},{"verse":23,"text":"Ninyi ambao mnamcha \\nd Bwana\\nd*, msifuni!"},{"verse":24,"text":"Kwa maana hakupuuza wala kudharau"},{"verse":25,"text":"Kwako wewe hutoka kiini cha sifa zangu katika kusanyiko kubwa,"},{"verse":26,"text":"Maskini watakula na kushiba,"},{"verse":27,"text":"Miisho yote ya dunia itakumbuka"},{"verse":28,"text":"kwa maana ufalme ni wa \\nd Bwana\\nd*"},{"verse":29,"text":"Matajiri wote wa dunia watasherehekea na kuabudu."},{"verse":30,"text":"Wazao wa baadaye watamtumikia yeye;"},{"verse":31,"text":"Watatangaza haki yake kwa watu"}]}