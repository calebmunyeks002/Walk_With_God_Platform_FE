{"verses":[{"verse":1,"text":"Mungu aturehemu na kutubariki,"},{"verse":2,"text":"ili njia zako zijulikane duniani,"},{"verse":3,"text":"Ee Mungu, mataifa na wakusifu,"},{"verse":4,"text":"Mataifa yote wafurahi na kuimba kwa shangwe,"},{"verse":5,"text":"Ee Mungu, mataifa na wakusifu,"},{"verse":6,"text":"Ndipo nchi itatoa mazao yake,"},{"verse":7,"text":"Mungu atatubariki"}]}