{"verses":[{"verse":1,"text":"Ee \\nd Bwana\\nd*, mkumbuke Daudi"},{"verse":2,"text":"Aliapa kiapo kwa \\nd Bwana\\nd*"},{"verse":3,"text":"“Sitaingia nyumbani mwangu"},{"verse":4,"text":"sitaruhusu usingizi katika macho yangu,"},{"verse":5,"text":"mpaka nitakapompatia \\nd Bwana\\nd* mahali,"},{"verse":6,"text":"Tulisikia habari hii huko Efrathi,"},{"verse":7,"text":"“Twendeni kwenye makao yake,"},{"verse":8,"text":"inuka, Ee \\nd Bwana\\nd*, uje mahali pako pa kupumzikia,"},{"verse":9,"text":"Makuhani wako na wavikwe haki,"},{"verse":10,"text":"Kwa ajili ya Daudi mtumishi wako,"},{"verse":11,"text":"\\nd Bwana\\nd* alimwapia Daudi kiapo,"},{"verse":12,"text":"kama wanao watashika Agano langu"},{"verse":13,"text":"Kwa maana \\nd Bwana\\nd* ameichagua Sayuni,"},{"verse":14,"text":"“Hapa ni mahali pangu pa kupumzika milele na milele;"},{"verse":15,"text":"Nitambariki kwa kumpa mahitaji tele:"},{"verse":16,"text":"Nitawavika makuhani wake wokovu,"},{"verse":17,"text":"“Hapa nitamchipushia Daudi pembe,\\f + \\fr 132:17 \\ft Pembe inawakilisha nguvu.\\f*"},{"verse":18,"text":"Adui zake nitawavika aibu,"}]}