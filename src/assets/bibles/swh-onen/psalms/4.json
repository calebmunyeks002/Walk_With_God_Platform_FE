{"verses":[{"verse":1,"text":"Nijibu nikuitapo,"},{"verse":2,"text":"Enyi watu, mtabadilisha utukufu wangu"},{"verse":3,"text":"Fahamuni hakika kwamba \\nd Bwana\\nd* amewatenga"},{"verse":4,"text":"Katika hasira yako, usitende dhambi."},{"verse":5,"text":"Toeni dhabihu zilizo haki;"},{"verse":6,"text":"Wengi wanauliza, “Ni nani awezaye"},{"verse":7,"text":"Wewe umejaza moyo wangu kwa furaha kubwa"},{"verse":8,"text":"Nitajilaza chini na kulala kwa amani,"}]}