{"verses":[{"verse":1,"text":"“Wewe fanya maombolezo kuhusu wakuu wa Israeli"},{"verse":2,"text":"na useme:"},{"verse":3,"text":"Alimlea mmoja wa watoto wake,"},{"verse":4,"text":"Mataifa wakasikia habari zake,"},{"verse":5,"text":"“ ‘Mama yake alipongoja na kuona tumaini lake halitimiziki,"},{"verse":6,"text":"Alizungukazunguka miongoni mwa simba,"},{"verse":7,"text":"Akabomoa ngome zao"},{"verse":8,"text":"Kisha mataifa wakaja dhidi yake"},{"verse":9,"text":"Kwa kutumia ndoana wakamvutia kwenye tundu"},{"verse":10,"text":"“ ‘Mama yako alikuwa kama mzabibu"},{"verse":11,"text":"Matawi yake yalikuwa na nguvu,"},{"verse":12,"text":"Lakini ulingʼolewa kwa hasira kali"},{"verse":13,"text":"Sasa umepandwa jangwani"},{"verse":14,"text":"Moto ulienea kuanzia katika mmojawapo ya matawi yake makubwa"}]}