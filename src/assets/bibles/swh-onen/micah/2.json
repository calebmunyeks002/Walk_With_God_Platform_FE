{"verses":[{"verse":1,"text":"Ole kwa wale wapangao uovu,"},{"verse":2,"text":"Wanatamani mashamba na kuyakamata,"},{"verse":3,"text":"Kwa hiyo, \\nd Bwana\\nd* asema:"},{"verse":4,"text":"Siku hiyo watu watawadhihaki,"},{"verse":5,"text":"Kwa hiyo hutakuwa na yeyote katika kusanyiko la \\nd Bwana\\nd*"},{"verse":6,"text":"Manabii wao husema, “Usitabiri."},{"verse":7,"text":"Je, ingesemwa, ee nyumba ya Yakobo:"},{"verse":8,"text":"Siku hizi watu wangu wameinuka"},{"verse":9,"text":"Unawahamisha wanawake wa watu wangu"},{"verse":10,"text":"Inuka, nenda zako!"},{"verse":11,"text":"Ikiwa mwongo na mdanganyifu atakuja na kusema,"},{"verse":12,"text":"“Hakika nitawakusanya ninyi nyote, ee Yakobo,"},{"verse":13,"text":"Yeye afunguaye njia atawatangulia;"}]}