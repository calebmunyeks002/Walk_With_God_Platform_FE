{"verses":[{"verse":1,"text":"Katika siku za mwisho"},{"verse":2,"text":"Mataifa mengi yatakuja na kusema,"},{"verse":3,"text":"Atahukumu kati ya mataifa mengi,"},{"verse":4,"text":"Kila mtu ataketi chini ya mzabibu wake"},{"verse":5,"text":"Mataifa yote yanaweza kutembea"},{"verse":6,"text":"“Katika siku hiyo,” asema \\nd Bwana\\nd*,"},{"verse":7,"text":"Nitawafanya walemavu kuwa mabaki,"},{"verse":8,"text":"Lakini kuhusu wewe, ee mnara wa ulinzi wa kundi,"},{"verse":9,"text":"Kwa nini sasa unalia kwa nguvu:"},{"verse":10,"text":"Gaagaa kwa utungu, ee Binti Sayuni,"},{"verse":11,"text":"Lakini sasa mataifa mengi"},{"verse":12,"text":"Lakini hawayajui"},{"verse":13,"text":"“Inuka upure, ee Binti Sayuni,"}]}