{"verses":[{"verse":1,"text":"Kisha nikasema,"},{"verse":2,"text":"ninyi mnaochukia mema"},{"verse":3,"text":"ninyi mnaokula nyama ya watu wangu,"},{"verse":4,"text":"Kisha watamlilia \\nd Bwana\\nd*,"},{"verse":5,"text":"Hili ndilo asemalo \\nd Bwana\\nd*:"},{"verse":6,"text":"Kwa hiyo usiku utawajieni, msiweze kuwa na maono,"},{"verse":7,"text":"Waonaji wataaibika"},{"verse":8,"text":"Lakini kuhusu mimi, nimejazwa nguvu,"},{"verse":9,"text":"Sikieni hili, enyi viongozi wa nyumba ya Yakobo,"},{"verse":10,"text":"mnaojenga Sayuni kwa kumwaga damu"},{"verse":11,"text":"Viongozi wake wanahukumu kwa rushwa,"},{"verse":12,"text":"Kwa hiyo kwa sababu yenu,"}]}