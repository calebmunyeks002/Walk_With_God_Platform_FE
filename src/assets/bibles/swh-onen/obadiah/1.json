{"verses":[{"verse":1,"text":"Maono ya Obadia."},{"verse":2,"text":"“Angalieni, nitawafanya wadogo miongoni mwa mataifa,"},{"verse":3,"text":"Kiburi cha moyo wako kimekudanganya,"},{"verse":4,"text":"Ingawa unapaa juu kama tai"},{"verse":5,"text":"“Ikiwa wevi wangekuja kwako,"},{"verse":6,"text":"Lakini tazama jinsi Esau atakavyotekwa,"},{"verse":7,"text":"Wote ulioungana nao watakufukuza hadi mpakani,"},{"verse":8,"text":"“Katika siku hiyo,” asema \\nd Bwana\\nd*,"},{"verse":9,"text":"Ee Temani, mashujaa wako watatiwa hofu,"},{"verse":10,"text":"Kwa sababu ya jeuri uliyofanya dhidi ya ndugu yako Yakobo,"},{"verse":11,"text":"Siku ile ulisimama mbali ukiangalia"},{"verse":12,"text":"Usingemdharau ndugu yako"},{"verse":13,"text":"Usingeingia katika malango ya watu wangu"},{"verse":14,"text":"Usingengoja kwenye njia panda"},{"verse":15,"text":"“Siku ya \\nd Bwana\\nd* iko karibu"},{"verse":16,"text":"Kama vile ulivyokunywa juu ya mlima wangu mtakatifu,"},{"verse":17,"text":"Lakini katika Mlima Sayuni kutakuwepo"},{"verse":18,"text":"Nyumba ya Yakobo itakuwa moto,"},{"verse":19,"text":"Watu kutoka nchi ya Negebu"},{"verse":20,"text":"Kundi la Waisraeli walioko uhamishoni Kanaani"},{"verse":21,"text":"Waokoaji watakwea juu ya Mlima Sayuni"}]}