{"verses":[{"verse":1,"text":"Efraimu anajilisha upepo;"},{"verse":2,"text":"\\nd Bwana\\nd* analo shtaka dhidi ya Yuda,"},{"verse":3,"text":"Yakobo akiwa tumboni alishika kisigino cha kaka yake;"},{"verse":4,"text":"Alishindana na malaika na kumshinda;"},{"verse":5,"text":"\\nd Bwana\\nd* Mungu Mwenye Nguvu Zote,"},{"verse":6,"text":"Lakini ni lazima urudi kwa Mungu wako;"},{"verse":7,"text":"Mfanyabiashara hutumia vipimo vya udanganyifu;"},{"verse":8,"text":"Efraimu hujisifu akisema,"},{"verse":9,"text":"“Mimi ndimi \\nd Bwana\\nd* Mungu wenu"},{"verse":10,"text":"Niliongea na manabii, nikawapa maono mengi"},{"verse":11,"text":"Je, Gileadi si mwovu?"},{"verse":12,"text":"Yakobo alikimbilia katika nchi ya Aramu;"},{"verse":13,"text":"\\nd Bwana\\nd* alimtumia nabii"},{"verse":14,"text":"Lakini Efraimu amemchochea sana hasira;"}]}