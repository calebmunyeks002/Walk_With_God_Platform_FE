{"verses":[{"verse":1,"text":"Sikieni neno la \\nd Bwana\\nd*, enyi Waisraeli,"},{"verse":2,"text":"Kuna kulaani tu, uongo na uuaji,"},{"verse":3,"text":"Kwa sababu hii nchi huomboleza,"},{"verse":4,"text":"“Lakini mtu awaye yote na asilete shtaka,"},{"verse":5,"text":"Unajikwaa usiku na mchana,"},{"verse":6,"text":"watu wangu wanaangamizwa"},{"verse":7,"text":"Kadiri makuhani walivyoongezeka,"},{"verse":8,"text":"Hujilisha dhambi za watu wangu"},{"verse":9,"text":"Hata itakuwa: Kama walivyo watu,"},{"verse":10,"text":"“Watakula lakini hawatashiba;"},{"verse":11,"text":"katika ukahaba,"},{"verse":12,"text":"wa watu wangu."},{"verse":13,"text":"Wanatoa dhabihu juu ya vilele vya milima"},{"verse":14,"text":"“Sitawaadhibu binti zenu wakati"},{"verse":15,"text":"“Ingawa umefanya uzinzi, ee Israeli,"},{"verse":16,"text":"Waisraeli ni wakaidi,"},{"verse":17,"text":"Efraimu amejiunga na sanamu,"},{"verse":18,"text":"Hata wakati wamemaliza vileo vyao"},{"verse":19,"text":"Kisulisuli kitawafagilia mbali"}]}