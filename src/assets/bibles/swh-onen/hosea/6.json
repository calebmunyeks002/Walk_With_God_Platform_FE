{"verses":[{"verse":1,"text":"“Njooni, tumrudie \\nd Bwana\\nd*."},{"verse":2,"text":"Baada ya siku mbili atatufufua;"},{"verse":3,"text":"Tumkubali \\nd Bwana\\nd*,"},{"verse":4,"text":"“Nifanye nini nawe, Efraimu?"},{"verse":5,"text":"Kwa hiyo ninawakata ninyi vipande vipande"},{"verse":6,"text":"Kwa maana nataka rehema, wala si dhabihu,"},{"verse":7,"text":"Wamevunja Agano kama Adamu:"},{"verse":8,"text":"Gileadi ni mji wenye watu waovu,"},{"verse":9,"text":"Kama wanyangʼanyi wamviziavyo mtu,"},{"verse":10,"text":"Nimeona jambo la kutisha"},{"verse":11,"text":"“Pia kwa ajili yako, Yuda,"}]}