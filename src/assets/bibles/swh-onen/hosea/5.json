{"verses":[{"verse":1,"text":"“Sikieni hili, enyi makuhani!"},{"verse":2,"text":"Waasi wamezidisha sana mauaji."},{"verse":3,"text":"Ninajua yote kuhusu Efraimu,"},{"verse":4,"text":"“Matendo yao hayawaachii"},{"verse":5,"text":"Kiburi cha Israeli kinashuhudia dhidi yao;"},{"verse":6,"text":"Wakati wanapokwenda na makundi yao"},{"verse":7,"text":"Wao si waaminifu kwa \\nd Bwana\\nd*;"},{"verse":8,"text":"“Pigeni tarumbeta huko Gibea,"},{"verse":9,"text":"Efraimu ataachwa ukiwa"},{"verse":10,"text":"Viongozi wa Yuda ni kama wale"},{"verse":11,"text":"Efraimu ameonewa,"},{"verse":12,"text":"Mimi ni kama nondo kwa Efraimu,"},{"verse":13,"text":"“Wakati Efraimu alipoona ugonjwa wake,"},{"verse":14,"text":"Kwa maana nitakuwa kama simba kwa Efraimu,"},{"verse":15,"text":"Kisha nitarudi mahali pangu"}]}