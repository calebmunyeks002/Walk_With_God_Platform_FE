{"verses":[{"verse":1,"text":"kila mara nilipotaka kumponya Israeli,"},{"verse":2,"text":"lakini hawafahamu kwamba"},{"verse":3,"text":"“Wanamfurahisha sana mfalme kwa maovu yao,"},{"verse":4,"text":"Wote ni wazinzi,"},{"verse":5,"text":"Katika sikukuu ya mfalme wetu"},{"verse":6,"text":"Mioyo yao ni kama tanuru,"},{"verse":7,"text":"Wote ni moto kama tanuru;"},{"verse":8,"text":"“Efraimu anajichanganya na mataifa;"},{"verse":9,"text":"Wageni wananyonya nguvu zake,"},{"verse":10,"text":"Kiburi cha Israeli kinashuhudia dhidi yake,"},{"verse":11,"text":"“Efraimu ni kama hua,"},{"verse":12,"text":"Wakati watakapokwenda,"},{"verse":13,"text":"Ole wao, kwa sababu"},{"verse":14,"text":"Hawanililii mimi kutoka mioyoni mwao,"},{"verse":15,"text":"Niliwafundisha na kuwatia nguvu,"},{"verse":16,"text":"Hawamgeukii Yeye Aliye Juu Sana,"}]}