{"verses":[{"verse":1,"text":"“Wekeni tarumbeta midomoni mwenu!"},{"verse":2,"text":"Israeli ananililia,"},{"verse":3,"text":"Lakini Israeli amekataa lile lililo jema,"},{"verse":4,"text":"Wanaweka wafalme bila idhini yangu,"},{"verse":5,"text":"Ee Samaria, tupilieni mbali sanamu yenu ya ndama!"},{"verse":6,"text":"Zimetoka katika Israeli!"},{"verse":7,"text":"“Wanapanda upepo"},{"verse":8,"text":"Israeli amemezwa;"},{"verse":9,"text":"Kwa kuwa wamepanda kwenda Ashuru"},{"verse":10,"text":"Ingawa wamejiuza wenyewe miongoni mwa mataifa,"},{"verse":11,"text":"“Ingawa Efraimu alijenga madhabahu nyingi"},{"verse":12,"text":"Nimeandika kwa ajili yao mambo mengi"},{"verse":13,"text":"Wanatoa dhabihu nilizopewa mimi"},{"verse":14,"text":"Israeli amemsahau Muumba wake"}]}