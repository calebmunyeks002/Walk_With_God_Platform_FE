{"verses":[{"verse":1,"text":"Usifurahie, ee Israeli;"},{"verse":2,"text":"Sakafu za kupuria nafaka na mashinikizo ya kukamulia divai"},{"verse":3,"text":"Hawataishi katika nchi ya \\nd Bwana\\nd*,"},{"verse":4,"text":"Hawatammiminia \\nd Bwana\\nd* sadaka ya divai"},{"verse":5,"text":"Mtafanya nini katika siku ya sikukuu zenu zilizoamriwa,"},{"verse":6,"text":"Hata ikiwa wataokoka maangamizi,"},{"verse":7,"text":"Siku za adhabu zinakuja,"},{"verse":8,"text":"Nabii, pamoja na Mungu wangu,"},{"verse":9,"text":"Wamezama sana katika rushwa,"},{"verse":10,"text":"“Nilipompata Israeli, ilikuwa kama"},{"verse":11,"text":"Utukufu wa Efraimu utaruka kama ndege:"},{"verse":12,"text":"Hata wakilea watoto,"},{"verse":13,"text":"Nimemwona Efraimu, kama Tiro,"},{"verse":14,"text":"Wape, Ee \\nd Bwana\\nd*,"},{"verse":15,"text":"“Kwa sababu ya uovu wao wote huko Gilgali,"},{"verse":16,"text":"Efraimu ameharibiwa,"},{"verse":17,"text":"Mungu wangu atawakataa"}]}