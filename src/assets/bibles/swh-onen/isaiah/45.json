{"verses":[{"verse":1,"text":"“Hili ndilo asemalo \\nd Bwana\\nd* kwa mpakwa mafuta wake,"},{"verse":2,"text":"Nitakwenda mbele yako"},{"verse":3,"text":"Nitakupa hazina za gizani,"},{"verse":4,"text":"Kwa ajili ya Yakobo mtumishi wangu,"},{"verse":5,"text":"Mimi ndimi \\nd Bwana\\nd*, wala hakuna mwingine,"},{"verse":6,"text":"ili kutoka mawio ya jua"},{"verse":7,"text":"Mimi ninaumba nuru na kuhuluku giza,"},{"verse":8,"text":"“Enyi mbingu juu, nyesheni haki,"},{"verse":9,"text":"“Ole wake yeye ashindanaye na Muumba wake,"},{"verse":10,"text":"Ole wake amwambiaye baba yake,"},{"verse":11,"text":"“Hili ndilo asemalo \\nd Bwana\\nd*,"},{"verse":12,"text":"Mimi ndiye niliyeumba dunia"},{"verse":13,"text":"Mimi nitamwinua Koreshi katika haki yangu:"},{"verse":14,"text":"Hili ndilo asemalo \\nd Bwana\\nd*:"},{"verse":15,"text":"Hakika wewe u Mungu unayejificha,"},{"verse":16,"text":"Wote watengenezao sanamu wataaibika na kutahayarika;"},{"verse":17,"text":"Lakini Israeli ataokolewa na \\nd Bwana\\nd*"},{"verse":18,"text":"Kwa kuwa hili ndilo asemalo \\nd Bwana\\nd*,"},{"verse":19,"text":"Sijasema sirini,"},{"verse":20,"text":"“Kusanyikeni pamoja mje,"},{"verse":21,"text":"Tangazeni litakalokuwepo, lisemeni hilo,"},{"verse":22,"text":"“Nigeukieni mimi, nanyi mkaokolewe,"},{"verse":23,"text":"Nimeapa kwa nafsi yangu,"},{"verse":24,"text":"Watasema kuhusu mimi,"},{"verse":25,"text":"Lakini katika \\nd Bwana\\nd* wazao wote wa Israeli"}]}