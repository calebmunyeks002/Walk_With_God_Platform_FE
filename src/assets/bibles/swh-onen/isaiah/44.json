{"verses":[{"verse":1,"text":"“Lakini sasa sikiliza, ee Yakobo, mtumishi wangu,"},{"verse":2,"text":"Hili ndilo asemalo \\nd Bwana\\nd*,"},{"verse":3,"text":"Kwa maana nitamimina maji juu ya nchi yenye kiu,"},{"verse":4,"text":"Nao watachipua kama manyasi katika shamba la majani,"},{"verse":5,"text":"Mmoja atasema, ‘Mimi ni wa \\nd Bwana\\nd*’;"},{"verse":6,"text":"“Hili ndilo asemalo \\nd Bwana\\nd*,"},{"verse":7,"text":"Ni nani basi aliye kama mimi? Yeye na atangaze."},{"verse":8,"text":"Msitetemeke, msiogope."},{"verse":9,"text":"Wote wachongao sanamu ni ubatili,"},{"verse":10,"text":"Ni nani atengenezaye mungu na kusubu sanamu,"},{"verse":11,"text":"Yeye pamoja na wenziwe wa aina yake wataaibishwa,"},{"verse":12,"text":"Muhunzi huchukua kifaa"},{"verse":13,"text":"Seremala hupima kwa kutumia kamba"},{"verse":14,"text":"Hukata miti ya mierezi,"},{"verse":15,"text":"Ni kuni ya binadamu:"},{"verse":16,"text":"Sehemu ya kuni huziweka motoni,"},{"verse":17,"text":"Mabaki yake hutengeneza mungu, sanamu yake;"},{"verse":18,"text":"Hawajui chochote, hawaelewi chochote,"},{"verse":19,"text":"Hakuna anayefikiri,"},{"verse":20,"text":"Hujilisha kwa majivu, moyo uliodanganyika humpotosha;"},{"verse":21,"text":"“Ee Yakobo, kumbuka mambo haya,"},{"verse":22,"text":"Nimeyafuta makosa yako kama wingu,"},{"verse":23,"text":"Enyi mbingu, imbeni kwa furaha,"},{"verse":24,"text":"“Hili ndilo asemalo \\nd Bwana\\nd*,"},{"verse":25,"text":"“mimi huzipinga ishara za manabii wa uongo,"},{"verse":26,"text":"niyathibitishaye maneno ya watumishi wake,"},{"verse":27,"text":"niambiaye kilindi cha maji, ‘Kauka,"},{"verse":28,"text":"nisemaye kuhusu Koreshi, ‘Yeye ni mchungaji wangu,"}]}