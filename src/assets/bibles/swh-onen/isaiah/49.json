{"verses":[{"verse":1,"text":"Nisikilizeni, enyi visiwa, sikieni hili,"},{"verse":2,"text":"Akafanya kinywa changu kuwa kama upanga ulionolewa,"},{"verse":3,"text":"Akaniambia, “Wewe u mtumishi wangu,"},{"verse":4,"text":"Lakini nilisema, “Nimetumika bure,"},{"verse":5,"text":"Sasa \\nd Bwana\\nd* asema:"},{"verse":6,"text":"yeye asema:"},{"verse":7,"text":"Hili ndilo asemalo \\nd Bwana\\nd*,"},{"verse":8,"text":"Hili ndilo asemalo \\nd Bwana\\nd*:"},{"verse":9,"text":"kuwaambia mateka, ‘Tokeni nje,’"},{"verse":10,"text":"Hawataona njaa wala kuona kiu,"},{"verse":11,"text":"Nitaifanya milima yangu yote kuwa barabara,"},{"verse":12,"text":"Tazama, watakuja kutoka mbali:"},{"verse":13,"text":"Pigeni kelele kwa furaha, enyi mbingu;"},{"verse":14,"text":"Lakini Sayuni alisema, “\\nd Bwana\\nd* ameniacha,"},{"verse":15,"text":"“Je, mama aweza kumsahau mtoto"},{"verse":16,"text":"Tazama, nimekuchora kama muhuri"},{"verse":17,"text":"Wana wako wanaharakisha kurudi,"},{"verse":18,"text":"Inua macho yako ukatazame pande zote:"},{"verse":19,"text":"“Ingawa uliangamizwa na kufanywa ukiwa,"},{"verse":20,"text":"Watoto waliozaliwa wakati wa msiba wako"},{"verse":21,"text":"Ndipo utasema moyoni mwako,"},{"verse":22,"text":"Hili ndilo asemalo \\nd Bwana\\nd* Mwenyezi:"},{"verse":23,"text":"Wafalme watakuwa baba zenu wa kuwalea,"},{"verse":24,"text":"Je, nyara zaweza kuchukuliwa kutoka kwa mashujaa wa vita,"},{"verse":25,"text":"Lakini hili ndilo asemalo \\nd Bwana\\nd*:"},{"verse":26,"text":"Nitawafanya wale wanaokuonea kula nyama yao wenyewe,"}]}