{"verses":[{"verse":1,"text":"Jangwa na nchi kame vitafurahi;"},{"verse":2,"text":"litachanua maua,"},{"verse":3,"text":"Itieni nguvu mikono iliyo dhaifu,"},{"verse":4,"text":"waambieni wale wenye mioyo ya hofu,"},{"verse":5,"text":"Ndipo macho ya vipofu yatafumbuliwa"},{"verse":6,"text":"Ndipo kilema atarukaruka kama kulungu,"},{"verse":7,"text":"Mchanga wa moto utakuwa bwawa la maji,"},{"verse":8,"text":"Nako kutakuwa na njia kuu,"},{"verse":9,"text":"Huko hakutakuwepo na simba,"},{"verse":10,"text":"waliokombolewa na \\nd Bwana\\nd* watarudi."}]}