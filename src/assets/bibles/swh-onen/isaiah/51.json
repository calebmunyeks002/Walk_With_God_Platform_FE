{"verses":[{"verse":1,"text":"“Nisikilizeni, ninyi mnaofuatia haki"},{"verse":2,"text":"mwangalieni Abrahamu, baba yenu,"},{"verse":3,"text":"Hakika \\nd Bwana\\nd* ataifariji Sayuni,"},{"verse":4,"text":"“Nisikilizeni, watu wangu;"},{"verse":5,"text":"Haki yangu inakaribia mbio,"},{"verse":6,"text":"Inueni macho yenu mbinguni,"},{"verse":7,"text":"“Nisikieni, ninyi mnaojua lililo sawa,"},{"verse":8,"text":"Kwa maana nondo atawala kama vazi,"},{"verse":9,"text":"Amka, Amka! Jivike nguvu,"},{"verse":10,"text":"Si ni wewe uliyekausha bahari,"},{"verse":11,"text":"Wale waliolipiwa fidia na \\nd Bwana\\nd* watarudi."},{"verse":12,"text":"“Mimi, naam mimi,"},{"verse":13,"text":"kwamba mnamsahau \\nd Bwana\\nd* Muumba wenu,"},{"verse":14,"text":"Wafungwa waliojikunyata kwa hofu"},{"verse":15,"text":"Kwa maana Mimi ndimi \\nd Bwana\\nd*, Mungu wako,"},{"verse":16,"text":"Nimeweka maneno yangu kinywani mwako"},{"verse":17,"text":"Amka, amka!"},{"verse":18,"text":"Kati ya wana wote aliowazaa"},{"verse":19,"text":"Majanga haya mawili yamekuja juu yako:"},{"verse":20,"text":"Wana wako wamezimia,"},{"verse":21,"text":"Kwa hiyo sikiliza hili, wewe uliyeteswa,"},{"verse":22,"text":"Hili ndilo asemalo \\nd Bwana\\nd* Mwenyezi wako,"},{"verse":23,"text":"Nitakiweka mikononi mwa watesi wako,"}]}