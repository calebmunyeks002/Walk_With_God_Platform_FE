{"verses":[{"verse":1,"text":"Kwa ajili ya Sayuni sitanyamaza,"},{"verse":2,"text":"Mataifa wataona haki yako,"},{"verse":3,"text":"Utakuwa taji ya fahari mkononi mwa \\nd Bwana\\nd*,"},{"verse":4,"text":"Hawatakuita tena Aliyeachwa,"},{"verse":5,"text":"Kama vile kijana aoavyo mwanamwali,"},{"verse":6,"text":"Nimeweka walinzi juu ya kuta zako, ee Yerusalemu,"},{"verse":7,"text":"msimwache apumzike hadi atakapoufanya imara Yerusalemu"},{"verse":8,"text":"\\nd Bwana\\nd* ameapa kwa mkono wake wa kuume"},{"verse":9,"text":"lakini wale waivunao nafaka wataila"},{"verse":10,"text":"Piteni, piteni katika malango!"},{"verse":11,"text":"\\nd Bwana\\nd* ametoa tangazo"},{"verse":12,"text":"Wataitwa Watu Watakatifu,"}]}