{"verses":[{"verse":1,"text":"“Shuka uketi mavumbini,"},{"verse":2,"text":"Chukua mawe ya kusagia, usage unga,"},{"verse":3,"text":"Uchi wako utafunuliwa"},{"verse":4,"text":"Mkombozi wetu: \\nd Bwana\\nd* Mwenye Nguvu Zote ndilo jina lake;"},{"verse":5,"text":"“Keti kimya, ingia gizani,"},{"verse":6,"text":"Niliwakasirikia watu wangu"},{"verse":7,"text":"Ukasema, ‘Nitaendelea"},{"verse":8,"text":"“Sasa basi, sikiliza, ewe kiumbe mpenda anasa,"},{"verse":9,"text":"Haya mawili yatakupata, kufumba na kufumbua,"},{"verse":10,"text":"Umeutegemea uovu wako,"},{"verse":11,"text":"Maafa yatakujia,"},{"verse":12,"text":"“Endelea basi na uaguzi wako,"},{"verse":13,"text":"Ushauri wote uliopokea umekuchosha bure!"},{"verse":14,"text":"Hakika wako kama mabua makavu;"},{"verse":15,"text":"Hayo ndiyo yote wanayoweza kuwatendea ninyi,"}]}