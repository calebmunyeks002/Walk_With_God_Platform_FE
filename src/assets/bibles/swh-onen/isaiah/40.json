{"verses":[{"verse":1,"text":"Wafarijini, wafarijini watu wangu,"},{"verse":2,"text":"Sema na Yerusalemu kwa upole,"},{"verse":3,"text":"Sauti ya mtu aliaye:"},{"verse":4,"text":"Kila bonde litainuliwa,"},{"verse":5,"text":"Utukufu wa \\nd Bwana\\nd* utafunuliwa,"},{"verse":6,"text":"Sauti husema, “Piga kelele.”"},{"verse":7,"text":"Majani hunyauka na maua huanguka,"},{"verse":8,"text":"Majani hunyauka na maua huanguka,"},{"verse":9,"text":"Wewe uletaye habari njema Sayuni,"},{"verse":10,"text":"Tazameni, \\nd Bwana\\nd* Mwenyezi anakuja na nguvu,"},{"verse":11,"text":"Huchunga kundi lake kama mchungaji wa mifugo:"},{"verse":12,"text":"Ni nani aliyepima maji ya bahari"},{"verse":13,"text":"Ni nani aliyeyafahamu mawazo ya \\nd Bwana\\nd*,"},{"verse":14,"text":"Ni nani ambaye \\nd Bwana\\nd* ametaka shauri kwake ili kumwelimisha,"},{"verse":15,"text":"Hakika mataifa ni kama tone ndani ya ndoo,"},{"verse":16,"text":"Lebanoni hautoshi kwa moto wa madhabahuni,"},{"verse":17,"text":"Mbele yake mataifa yote ni kama si kitu,"},{"verse":18,"text":"Basi, utamlinganisha Mungu na nani?"},{"verse":19,"text":"Kwa habari ya sanamu, fundi huisubu,"},{"verse":20,"text":"Mtu aliye maskini sana asiyeweza kuleta sadaka kama hii"},{"verse":21,"text":"Je, hujui?"},{"verse":22,"text":"Anakaa kwenye kiti cha enzi juu ya duara ya dunia,"},{"verse":23,"text":"Huwafanya wakuu kuwa si kitu,"},{"verse":24,"text":"Mara baada ya kupandwa,"},{"verse":25,"text":"“Utanilinganisha mimi na nani?"},{"verse":26,"text":"Inueni macho yenu mtazame mbinguni:"},{"verse":27,"text":"Kwa nini unasema, ee Yakobo,"},{"verse":28,"text":"Je wewe, hufahamu?"},{"verse":29,"text":"Huwapa nguvu waliolegea"},{"verse":30,"text":"Hata vijana huchoka na kulegea,"},{"verse":31,"text":"bali wale wamtumainio \\nd Bwana\\nd*"}]}