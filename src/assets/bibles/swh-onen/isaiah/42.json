{"verses":[{"verse":1,"text":"“Huyu hapa mtumishi wangu, ninayemtegemeza,"},{"verse":2,"text":"Hatapaza sauti wala kupiga kelele,"},{"verse":3,"text":"Mwanzi uliopondeka hatauvunja,"},{"verse":4,"text":"hatazimia roho wala kukata tamaa,"},{"verse":5,"text":"Hili ndilo asemalo Mungu, \\nd Bwana\\nd*,"},{"verse":6,"text":"“Mimi, \\nd Bwana\\nd*, nimekuita katika haki;"},{"verse":7,"text":"kuwafungua macho wale wasioona,"},{"verse":8,"text":"“Mimi ndimi \\nd Bwana\\nd*; hilo ndilo Jina langu!"},{"verse":9,"text":"Tazama, mambo ya kwanza yametokea,"},{"verse":10,"text":"Mwimbieni \\nd Bwana\\nd* wimbo mpya,"},{"verse":11,"text":"Jangwa na miji yake na vipaze sauti zao;"},{"verse":12,"text":"Wampe \\nd Bwana\\nd* utukufu,"},{"verse":13,"text":"\\nd Bwana\\nd* ataenda kama mtu mwenye nguvu,"},{"verse":14,"text":"“Kwa muda mrefu nimenyamaza kimya,"},{"verse":15,"text":"Nitaharibu milima na vilima"},{"verse":16,"text":"Nitawaongoza vipofu kwenye njia ambayo hawajaijua,"},{"verse":17,"text":"Lakini wale wanaotumaini sanamu,"},{"verse":18,"text":"“Sikieni, enyi viziwi;"},{"verse":19,"text":"Ni nani aliye kipofu isipokuwa mtumishi wangu,"},{"verse":20,"text":"Mmeona vitu vingi, lakini hamkuzingatia;"},{"verse":21,"text":"Ilimpendeza \\nd Bwana\\nd*"},{"verse":22,"text":"Lakini hili ni taifa lililoibwa na kutekwa nyara,"},{"verse":23,"text":"Ni nani miongoni mwenu atakayesikiliza hili,"},{"verse":24,"text":"Ni nani aliyemtoa Yakobo kuwa mateka,"},{"verse":25,"text":"Hivyo akawamwagia hasira yake inayowaka,"}]}