{"verses":[{"verse":1,"text":"“Nilijifunua kwa watu wale ambao hawakuniulizia."},{"verse":2,"text":"Mchana kutwa nimeinyoosha mikono yangu"},{"verse":3,"text":"taifa ambalo daima hunikasirisha"},{"verse":4,"text":"watu waketio katikati ya makaburi"},{"verse":5,"text":"wasemao, ‘Kaa mbali; usinikaribie,"},{"verse":6,"text":"“Tazama, jambo hili hubakia limeandikwa mbele zangu:"},{"verse":7,"text":"dhambi zenu na dhambi za baba zenu,”"},{"verse":8,"text":"Hili ndilo asemalo \\nd Bwana\\nd*:"},{"verse":9,"text":"Nitawaleta wazao kutoka kwa Yakobo,"},{"verse":10,"text":"Sharoni itakuwa malisho"},{"verse":11,"text":"“Bali kwenu ninyi mnaomwacha \\nd Bwana\\nd*"},{"verse":12,"text":"nitawaagiza mfe kwa upanga,"},{"verse":13,"text":"Kwa hiyo hili ndilo asemalo \\nd Bwana\\nd* Mwenyezi:"},{"verse":14,"text":"Watumishi wangu wataimba"},{"verse":15,"text":"Mtaliacha jina lenu"},{"verse":16,"text":"Yeye aombaye baraka katika nchi"},{"verse":17,"text":"“Tazama, nitaumba"},{"verse":18,"text":"Lakini furahini na kushangilia daima"},{"verse":19,"text":"Nami nitaifurahia Yerusalemu"},{"verse":20,"text":"“Kamwe hatakuwepo tena ndani yake"},{"verse":21,"text":"Watajenga nyumba na kuishi ndani yake;"},{"verse":22,"text":"Hawatajenga nyumba, nao watu wengine waishi ndani yake,"},{"verse":23,"text":"Hawatajitaabisha kwa kazi bure,"},{"verse":24,"text":"Kabla hawajaita, nitajibu,"},{"verse":25,"text":"Mbwa mwitu na mwana-kondoo watalisha pamoja,"}]}