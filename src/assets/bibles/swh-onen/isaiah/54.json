{"verses":[{"verse":1,"text":"“Imba, ewe mwanamke tasa,"},{"verse":2,"text":"“Panua mahali pa hema lako,"},{"verse":3,"text":"Kwa maana utaenea upande wa kuume"},{"verse":4,"text":"“Usiogope, wewe hutaaibika."},{"verse":5,"text":"Kwa maana Muumba wako ndiye mume wako,"},{"verse":6,"text":"\\nd Bwana\\nd* atakuita urudi"},{"verse":7,"text":"“Kwa kitambo kidogo nilikuacha,"},{"verse":8,"text":"Katika ukali wa hasira"},{"verse":9,"text":"“Kwangu mimi jambo hili ni kama siku za Noa,"},{"verse":10,"text":"Ijapotikisika milima, na vilima viondolewe,"},{"verse":11,"text":"“Ewe mji uliyeteswa, uliyepigwa kwa dhoruba na usiyetulizwa,"},{"verse":12,"text":"Nitafanya minara yako ya akiki,"},{"verse":13,"text":"Watoto wako wote watafundishwa na \\nd Bwana\\nd*,"},{"verse":14,"text":"Kwa haki utathibitika:"},{"verse":15,"text":"Kama mtu yeyote akikushambulia,"},{"verse":16,"text":"“Tazama, ni mimi niliyemuumba mhunzi,"},{"verse":17,"text":"Hakuna silaha itakayofanyizwa dhidi yako"}]}