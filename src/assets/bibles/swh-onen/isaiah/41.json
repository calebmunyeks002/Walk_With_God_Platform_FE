{"verses":[{"verse":1,"text":"“Nyamazeni kimya mbele zangu, enyi visiwa!"},{"verse":2,"text":"“Ni nani aliyemchochea mmoja kutoka mashariki,"},{"verse":3,"text":"Huwafuatia na kuendelea salama,"},{"verse":4,"text":"Ni nani aliyefanya jambo hili na kulitimiliza,"},{"verse":5,"text":"Visiwa vimeliona na kuogopa,"},{"verse":6,"text":"kila mmoja humsaidia mwingine"},{"verse":7,"text":"Fundi humtia moyo sonara,"},{"verse":8,"text":"“Lakini wewe, ee Israeli, mtumishi wangu,"},{"verse":9,"text":"nilikuchukua toka miisho ya dunia,"},{"verse":10,"text":"Hivyo usiogope, kwa maana niko pamoja nawe;"},{"verse":11,"text":"“Wote walioona hasira dhidi yako"},{"verse":12,"text":"Ingawa utawatafuta adui zako,"},{"verse":13,"text":"Kwa maana Mimi ndimi \\nd Bwana\\nd*, Mungu wako,"},{"verse":14,"text":"Usiogope, ee Yakobo uliye mdudu,"},{"verse":15,"text":"“Tazama, nitakufanya chombo cha kupuria,"},{"verse":16,"text":"Utaipepeta, nao upepo utaichukua,"},{"verse":17,"text":"“Maskini na wahitaji wanatafuta maji,"},{"verse":18,"text":"Nitaifanya mito itiririke juu ya vilima vilivyo kame,"},{"verse":19,"text":"Katika jangwa nitaotesha"},{"verse":20,"text":"ili kwamba watu wapate kuona na kujua,"},{"verse":21,"text":"\\nd Bwana\\nd* asema, “Leta shauri lako."},{"verse":22,"text":"“Leteni sanamu zenu zituambie"},{"verse":23,"text":"tuambieni ni nini kitakachotokea baadaye,"},{"verse":24,"text":"Lakini ninyi ni zaidi ya bure kabisa,"},{"verse":25,"text":"“Nimemchochea mtu mmoja kutoka kaskazini,"},{"verse":26,"text":"Ni nani aliyenena hili tokea mwanzoni, ili tupate kujua,"},{"verse":27,"text":"Nilikuwa wa kwanza kumwambia Sayuni,"},{"verse":28,"text":"Ninatazama, lakini hakuna yeyote:"},{"verse":29,"text":"Tazama, wote ni ubatili!"}]}