{"verses":[{"verse":1,"text":"Mshambuliaji anasogea dhidi yako, Ninawi."},{"verse":2,"text":"\\nd Bwana\\nd* atarudisha fahari ya Yakobo,"},{"verse":3,"text":"Ngao za askari wake ni nyekundu,"},{"verse":4,"text":"Magari ya vita yanafanya msukosuko barabarani,"},{"verse":5,"text":"Anaita vikosi vilivyochaguliwa,"},{"verse":6,"text":"Malango ya mto yamefunguliwa wazi,"},{"verse":7,"text":"Imeagizwa kwamba mji uchukuliwe"},{"verse":8,"text":"Ninawi ni kama dimbwi,"},{"verse":9,"text":"Chukueni nyara za fedha!"},{"verse":10,"text":"Ameharibiwa, ametekwa nyara, ameachwa uchi!"},{"verse":11,"text":"Liko wapi sasa pango la simba,"},{"verse":12,"text":"Simba aliua mawindo ya kutosha watoto wake,"},{"verse":13,"text":"\\nd Bwana\\nd* Mwenye Nguvu Zote anatangaza,"}]}