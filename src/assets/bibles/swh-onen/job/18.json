{"verses":[{"verse":1,"text":"Bildadi Mshuhi akajibu:"},{"verse":2,"text":"“Je, ni lini utafika mwisho wa maneno haya?"},{"verse":3,"text":"Kwa nini sisi tunafikiriwa kama wanyama,"},{"verse":4,"text":"Wewe unayejirarua mwenyewe vipande vipande"},{"verse":5,"text":"“Taa ya mwovu imezimwa,"},{"verse":6,"text":"Mwanga hemani mwake umekuwa giza;"},{"verse":7,"text":"Nguvu za hatua zake zimedhoofishwa;"},{"verse":8,"text":"Miguu yake imemsukumia kwenye wavu,"},{"verse":9,"text":"Tanzi litamkamata kwenye kisigino;"},{"verse":10,"text":"Kitanzi kimefichwa ardhini kwa ajili yake;"},{"verse":11,"text":"Vitisho vimemtia hofu kila upande,"},{"verse":12,"text":"Janga linamwonea shauku;"},{"verse":13,"text":"Nayo yatakula sehemu ya ngozi yake;"},{"verse":14,"text":"Atangʼolewa kutoka usalama wa hema lake,"},{"verse":15,"text":"Moto utakaa katika hema lake;"},{"verse":16,"text":"Mizizi yake chini itakauka"},{"verse":17,"text":"Kumbukumbu lake litatoweka katika dunia,"},{"verse":18,"text":"Ameondolewa nuruni na kusukumiwa gizani,"},{"verse":19,"text":"Hana mtoto wala mzao miongoni mwa watu wake,"},{"verse":20,"text":"Watu wa magharibi watashangaa yaliyompata;"},{"verse":21,"text":"Hakika ndivyo yalivyo makao ya mtu mwovu;"}]}