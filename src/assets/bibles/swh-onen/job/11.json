{"verses":[{"verse":1,"text":"Ndipo Sofari Mnaamathi akajibu:"},{"verse":2,"text":"“Je, maneno haya yote yapite bila kujibiwa?"},{"verse":3,"text":"Je, maneno yako ya upuzi yawafanye watu wanyamaze kimya?"},{"verse":4,"text":"Unamwambia Mungu, ‘Imani yangu ni kamili"},{"verse":5,"text":"Aha! Laiti kwamba Mungu angesema,"},{"verse":6,"text":"naye akufunulie siri za hekima,"},{"verse":7,"text":"“Je, waweza kujua siri za Mungu?"},{"verse":8,"text":"Ni juu mno kuliko mbingu: waweza kufanya nini?"},{"verse":9,"text":"Kipimo chake ni kirefu kuliko dunia,"},{"verse":10,"text":"“Kama akija na kukufunga gerezani,"},{"verse":11,"text":"Hakika anawatambua watu wadanganyifu;"},{"verse":12,"text":"Mpumbavu aweza kuwa mwenye hekima,"},{"verse":13,"text":"“Hata sasa ukiutoa moyo wako kwake"},{"verse":14,"text":"ukiiondolea mbali ile dhambi iliyo mkononi mwako"},{"verse":15,"text":"ndipo utainua uso wako bila aibu;"},{"verse":16,"text":"Hakika utaisahau taabu yako,"},{"verse":17,"text":"Maisha yako yatangʼaa kuliko adhuhuri,"},{"verse":18,"text":"Utakuwa salama, kwa kuwa lipo tumaini;"},{"verse":19,"text":"Utalala, wala hakuna atakayekuogofya,"},{"verse":20,"text":"Bali macho ya waovu hayataona,"}]}