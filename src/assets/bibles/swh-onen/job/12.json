{"verses":[{"verse":1,"text":"Ndipo Ayubu akajibu:"},{"verse":2,"text":"“Bila shaka ninyi ndio watu,"},{"verse":3,"text":"Lakini mimi ninao ufahamu kama ninyi;"},{"verse":4,"text":"“Nimekuwa mtu wa kuchekwa na rafiki zangu,"},{"verse":5,"text":"Wanadamu wakiwa katika utulivu huwa na dharau kwa wale wenye msiba"},{"verse":6,"text":"Hema za wanyangʼanyi hazisumbuliwi,"},{"verse":7,"text":"“Lakini ulizeni wanyama, nao watawafundisha,"},{"verse":8,"text":"au zungumzeni na dunia, nayo itawafundisha,"},{"verse":9,"text":"Ni nani miongoni mwa hawa wote asiyejua"},{"verse":10,"text":"Mkononi mwake kuna uhai wa kila kiumbe,"},{"verse":11,"text":"Je, sikio haliyajaribu maneno"},{"verse":12,"text":"Je, hekima haipatikani katikati ya wazee?"},{"verse":13,"text":"“Hekima na nguvu ni vya Mungu;"},{"verse":14,"text":"Kile anachokibomoa hakiwezi kujengeka tena;"},{"verse":15,"text":"Akizuia maji, huwa pana ukame;"},{"verse":16,"text":"Kwake kuna nguvu na ushindi;"},{"verse":17,"text":"Yeye huwaondoa washauri wakiwa wametekwa nyara,"},{"verse":18,"text":"Huondoa pingu zilizofungwa na wafalme,"},{"verse":19,"text":"Huwaondoa makuhani wakiwa wametekwa nyara,"},{"verse":20,"text":"Hunyamazisha midomo ya washauri wanaoaminika,"},{"verse":21,"text":"Huwamwagia dharau wanaoheshimika,"},{"verse":22,"text":"Hufunua mambo ya ndani ya gizani,"},{"verse":23,"text":"Huyafanya mataifa yatukuke na kuyaangamiza;"},{"verse":24,"text":"Huwaondolea viongozi wa nchi akili zao;"},{"verse":25,"text":"Hupapasa gizani pasipokuwa na mwanga;"}]}