{"verses":[{"verse":1,"text":"“Kimbieni kwa usalama wenu, enyi watu wa Benyamini!"},{"verse":2,"text":"Nitamwangamiza Binti Sayuni,"},{"verse":3,"text":"Wachungaji pamoja na makundi yao"},{"verse":4,"text":"“Jiandaeni kwa vita dhidi yake!"},{"verse":5,"text":"Kwa hiyo inukeni, tufanye mashambulizi usiku,"},{"verse":6,"text":"Hivi ndivyo asemavyo \\nd Bwana\\nd* Mwenye Nguvu Zote:"},{"verse":7,"text":"Kama vile kisima kinavyomwaga maji yake,"},{"verse":8,"text":"Pokea onyo, ee Yerusalemu,"},{"verse":9,"text":"Hivi ndivyo asemavyo \\nd Bwana\\nd* Mwenye Nguvu Zote:"},{"verse":10,"text":"Niseme na nani na kumpa onyo?"},{"verse":11,"text":"Lakini nimejaa ghadhabu ya \\nd Bwana\\nd*,"},{"verse":12,"text":"Nyumba zao zitapewa watu wengine,"},{"verse":13,"text":"“Kuanzia aliye mdogo kabisa hadi aliye mkubwa kabisa,"},{"verse":14,"text":"Wanafunga majeraha ya watu wangu"},{"verse":15,"text":"Je, wanaona aibu kwa ajili ya tabia yao"},{"verse":16,"text":"Hivi ndivyo asemavyo \\nd Bwana\\nd*:"},{"verse":17,"text":"Niliweka walinzi juu yenu na kusema,"},{"verse":18,"text":"Kwa hiyo sikilizeni, enyi mataifa,"},{"verse":19,"text":"Sikia, ee nchi:"},{"verse":20,"text":"Unanifaa nini uvumba kutoka Sheba,"},{"verse":21,"text":"Kwa hiyo hivi ndivyo asemavyo \\nd Bwana\\nd*:"},{"verse":22,"text":"Hivi ndivyo asemavyo \\nd Bwana\\nd*:"},{"verse":23,"text":"Wamejifunga pinde na mkuki,"},{"verse":24,"text":"Tumesikia taarifa zao,"},{"verse":25,"text":"Usitoke kwenda mashambani"},{"verse":26,"text":"Enyi watu wangu, vaeni magunia"},{"verse":27,"text":"“Nimekufanya wewe kuwa kitu cha kujaribu chuma,"},{"verse":28,"text":"Wote ni waasi sugu,"},{"verse":29,"text":"Mivuo inavuma kwa nguvu,"},{"verse":30,"text":"Wanaitwa fedha iliyokataliwa,"}]}