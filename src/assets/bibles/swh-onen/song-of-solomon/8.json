{"verses":[{"verse":1,"text":"Laiti ungelikuwa kwangu kama ndugu wa kiume,"},{"verse":2,"text":"Ningelikuongoza na kukuleta"},{"verse":3,"text":"Mkono wake wa kushoto uko chini ya kichwa changu,"},{"verse":4,"text":"Binti za Yerusalemu, ninawaagiza:"},{"verse":5,"text":"Ni nani huyu anayekuja kutoka nyikani"},{"verse":6,"text":"Nitie kama muhuri moyoni mwako,"},{"verse":7,"text":"Maji mengi hayawezi kuuzimisha upendo,"},{"verse":8,"text":"Tunaye dada mdogo,"},{"verse":9,"text":"Kama yeye ni ukuta,"},{"verse":10,"text":"Mimi ni ukuta,"},{"verse":11,"text":"Solomoni alikuwa na shamba la mizabibu huko Baal-Hamoni;"},{"verse":12,"text":"Lakini shamba langu la mizabibu"},{"verse":13,"text":"Wewe ukaaye bustanini"},{"verse":14,"text":"Njoo, mpenzi wangu,"}]}