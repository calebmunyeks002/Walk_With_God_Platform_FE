{"verses":[{"verse":1,"text":"Usiku kucha kwenye kitanda changu"},{"verse":2,"text":"Sasa nitaondoka na kuzunguka mjini,"},{"verse":3,"text":"Walinzi walinikuta"},{"verse":4,"text":"Kitambo kidogo tu baada ya kuwapita"},{"verse":5,"text":"Binti za Yerusalemu, ninawaagiza"},{"verse":6,"text":"Ni nani huyu anayekuja kutoka jangwani"},{"verse":7,"text":"Tazama! Ni gari la Solomoni"},{"verse":8,"text":"wote wamevaa panga,"},{"verse":9,"text":"Mfalme Solomoni alijitengenezea gari;"},{"verse":10,"text":"Nguzo zake alizitengeneza kwa fedha,"},{"verse":11,"text":"Tokeni nje, ninyi binti za Sayuni,"}]}