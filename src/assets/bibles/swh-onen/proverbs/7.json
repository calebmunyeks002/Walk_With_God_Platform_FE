{"verses":[{"verse":1,"text":"Mwanangu, shika maneno yangu"},{"verse":2,"text":"Shika amri zangu nawe utaishi;"},{"verse":3,"text":"Yafunge katika vidole vyako;"},{"verse":4,"text":"Mwambie hekima, “Wewe ni dada yangu,”"},{"verse":5,"text":"watakuepusha na mwanamke mzinzi,"},{"verse":6,"text":"Kwenye dirisha la nyumba yangu"},{"verse":7,"text":"Niliona miongoni mwa wajinga,"},{"verse":8,"text":"Alikuwa akishuka njiani karibu na pembe ya kwake,"},{"verse":9,"text":"wakati wa machweo, jua likipungua nuru yake,"},{"verse":10,"text":"Ndipo huyo mwanamke akatoka kumlaki,"},{"verse":11,"text":"(Ni mwanamke mwenye makelele na mkaidi,"},{"verse":12,"text":"mara kwenye barabara za mji,"},{"verse":13,"text":"Huyo mwanamke alimkumbatia kijana na kumbusu,"},{"verse":14,"text":"“Nina sadaka za amani nyumbani;"},{"verse":15,"text":"Kwa hiyo nimetoka nje kukulaki;"},{"verse":16,"text":"Nimetandika kitanda changu"},{"verse":17,"text":"Nimetia manukato kitanda changu"},{"verse":18,"text":"Njoo, tuzame katika mapenzi mpaka asubuhi;"},{"verse":19,"text":"Mume wangu hayupo nyumbani;"},{"verse":20,"text":"Amechukua mkoba uliojazwa fedha"},{"verse":21,"text":"Kwa maneno laini yule mwanamke akampotosha;"},{"verse":22,"text":"Mara huyo kijana alimfuata yule mwanamke"},{"verse":23,"text":"mpaka mshale umchome ini lake,"},{"verse":24,"text":"Sasa basi wanangu, nisikilizeni;"},{"verse":25,"text":"Usiruhusu moyo wako ugeukie njia za huyo mwanamke,"},{"verse":26,"text":"Aliowaangusha ni wengi;"},{"verse":27,"text":"Nyumba yake ni njia kuu iendayo kaburini,\\f + \\fr 7:27 \\ft Kaburini hapa maana yake ni Kuzimu, kwa Kiebrania ni Sheol.\\f*"}]}