{"verses":[{"verse":1,"text":"Uketipo kula chakula na mtawala,"},{"verse":2,"text":"na utie kisu kooni mwako"},{"verse":3,"text":"Usitamani vyakula vyake vitamu"},{"verse":4,"text":"Usijitaabishe ili kuupata utajiri,"},{"verse":5,"text":"Kufumba na kufumbua utajiri hutoweka,"},{"verse":6,"text":"Usile chakula cha mtu mchoyo,"},{"verse":7,"text":"kwa maana yeye ni aina ya mtu"},{"verse":8,"text":"Utatapika kile kidogo ulichokula,"},{"verse":9,"text":"Usizungumze na mpumbavu,"},{"verse":10,"text":"Usisogeze jiwe la mpaka wa zamani"},{"verse":11,"text":"kwa kuwa Mtetezi wao ni mwenye nguvu,"},{"verse":12,"text":"Elekeza moyo wako kwenye mafundisho"},{"verse":13,"text":"Usimnyime mtoto adhabu,"},{"verse":14,"text":"Mwadhibu kwa fimbo"},{"verse":15,"text":"Mwanangu, kama moyo wako una hekima,"},{"verse":16,"text":"utu wangu wa ndani utafurahi,"},{"verse":17,"text":"Usiuruhusu moyo wako kuwaonea wivu wenye dhambi,"},{"verse":18,"text":"Hakika kuna tumaini la baadaye kwa ajili yako,"},{"verse":19,"text":"Sikiliza, mwanangu na uwe na hekima,"},{"verse":20,"text":"Usiwe miongoni mwa wanywao mvinyo,"},{"verse":21,"text":"kwa maana walevi na walafi huwa maskini,"},{"verse":22,"text":"Msikilize baba yako, aliyekuzaa,"},{"verse":23,"text":"Nunua kweli wala usiiuze,"},{"verse":24,"text":"Baba wa mwenye haki ana furaha kubwa,"},{"verse":25,"text":"Baba yako na mama yako na wafurahi,"},{"verse":26,"text":"Mwanangu, nipe moyo wako,"},{"verse":27,"text":"kwa maana kahaba ni shimo refu"},{"verse":28,"text":"Kama mnyangʼanyi, hungojea akivizia,"},{"verse":29,"text":"Ni nani mwenye ole?"},{"verse":30,"text":"Ni hao wakaao sana kwenye mvinyo,"},{"verse":31,"text":"Usiukodolee macho mvinyo wakati ukiwa mwekundu,"},{"verse":32,"text":"Mwishowe huuma kama nyoka"},{"verse":33,"text":"Macho yako yataona mambo mageni"},{"verse":34,"text":"Utakuwa kama alalaye katikati ya bahari,"},{"verse":35,"text":"Utasema, “Wamenipiga lakini sikuumia!"}]}