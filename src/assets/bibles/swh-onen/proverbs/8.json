{"verses":[{"verse":1,"text":"Je, hekima haitani?"},{"verse":2,"text":"Juu ya miinuko karibu na njia,"},{"verse":3,"text":"kando ya malango yaelekeayo mjini,"},{"verse":4,"text":"“Ni ninyi wanaume, ninaowaita;"},{"verse":5,"text":"Ninyi ambao ni wajinga, pateni akili;"},{"verse":6,"text":"Sikilizeni, kwa maana nina mambo muhimu ya kusema;"},{"verse":7,"text":"Kinywa changu husema lililo kweli,"},{"verse":8,"text":"Maneno yote ya kinywa changu ni haki;"},{"verse":9,"text":"Kwa wenye kupambanua yote ni sahihi;"},{"verse":10,"text":"Chagua mafundisho yangu badala ya fedha,"},{"verse":11,"text":"kwa maana hekima ina thamani kuliko marijani"},{"verse":12,"text":"“Mimi hekima, nakaa pamoja na busara;"},{"verse":13,"text":"Kumcha \\nd Bwana\\nd* ni kuchukia uovu;"},{"verse":14,"text":"Ushauri na hukumu sahihi ni vyangu;"},{"verse":15,"text":"Kwa msaada wangu wafalme hutawala"},{"verse":16,"text":"kwa msaada wangu wakuu hutawala,"},{"verse":17,"text":"Nawapenda wale wanipendao,"},{"verse":18,"text":"Utajiri na heshima viko kwangu,"},{"verse":19,"text":"Tunda langu ni bora kuliko dhahabu safi;"},{"verse":20,"text":"Natembea katika njia ya unyofu"},{"verse":21,"text":"nawapa utajiri wale wanipendao"},{"verse":22,"text":"“\\nd Bwana\\nd* aliniumba mwanzoni mwa kazi yake,"},{"verse":23,"text":"niliteuliwa tangu milele,"},{"verse":24,"text":"Wakati hazijakuwepo bahari, nilikwishazaliwa,"},{"verse":25,"text":"kabla milima haijawekwa mahali pake,"},{"verse":26,"text":"kabla hajaumba dunia wala mashamba yake"},{"verse":27,"text":"Nilikuwepo alipoziweka mbingu mahali pake,"},{"verse":28,"text":"wakati aliweka mawingu juu"},{"verse":29,"text":"wakati aliiwekea bahari mpaka wake"},{"verse":30,"text":"Wakati huo nilikuwa fundi stadi kando yake."},{"verse":31,"text":"nikifurahi katika dunia yake yote"},{"verse":32,"text":"“Basi sasa wanangu, nisikilizeni;"},{"verse":33,"text":"Sikilizeni mafundisho yangu mwe na hekima;"},{"verse":34,"text":"Heri mtu yule anisikilizaye mimi,"},{"verse":35,"text":"Kwa maana yeyote anipataye mimi amepata uzima"},{"verse":36,"text":"Lakini yeyote ashindwaye kunipata"}]}