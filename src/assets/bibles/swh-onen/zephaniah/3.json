{"verses":[{"verse":1,"text":"Ole mji wa wadhalimu,"},{"verse":2,"text":"Hautii mtu yeyote,"},{"verse":3,"text":"Maafisa wake ni simba wangurumao,"},{"verse":4,"text":"Manabii wake ni wenye kiburi,"},{"verse":5,"text":"\\nd Bwana\\nd* aliye ndani yake ni mwenye haki,"},{"verse":6,"text":"“Nimeyafutilia mbali mataifa,"},{"verse":7,"text":"Niliuambia huo mji,"},{"verse":8,"text":"\\nd Bwana\\nd* anasema,"},{"verse":9,"text":"“Ndipo nitatakasa midomo ya mataifa,"},{"verse":10,"text":"Kutoka ngʼambo ya mito ya Kushi"},{"verse":11,"text":"Siku hiyo hutaaibishwa"},{"verse":12,"text":"Lakini nitakuachia ndani yako"},{"verse":13,"text":"Mabaki ya Israeli hayatafanya kosa;"},{"verse":14,"text":"Imba, ee Binti Sayuni;"},{"verse":15,"text":"\\nd Bwana\\nd* amekuondolea adhabu yako,"},{"verse":16,"text":"Katika siku hiyo watauambia Yerusalemu,"},{"verse":17,"text":"\\nd Bwana\\nd* Mungu wako yu pamoja nawe,"},{"verse":18,"text":"“Huzuni katika sikukuu zilizoamriwa"},{"verse":19,"text":"Wakati huo nitawashughulikia"},{"verse":20,"text":"Wakati huo nitawakusanya;"}]}