{"verses":[{"verse":1,"text":"Neno la \\nd Bwana\\nd* ambalo lilimjia Yoeli mwana wa Pethueli."},{"verse":2,"text":"Sikilizeni hili, enyi wazee;"},{"verse":3,"text":"Waelezeni watoto wenu,"},{"verse":4,"text":"Kilichosazwa na kundi la tunutu"},{"verse":5,"text":"Amkeni, enyi walevi, mlie!"},{"verse":6,"text":"Taifa limevamia nchi yangu,"},{"verse":7,"text":"Limeharibu mizabibu yangu"},{"verse":8,"text":"Omboleza kama bikira aliyevaa nguo ya gunia"},{"verse":9,"text":"Sadaka za nafaka na sadaka za kinywaji"},{"verse":10,"text":"Mashamba yameharibiwa,"},{"verse":11,"text":"Kateni tamaa, enyi wakulima,"},{"verse":12,"text":"Mzabibu umekauka"},{"verse":13,"text":"Vaeni nguo ya gunia, enyi makuhani, muomboleze;"},{"verse":14,"text":"Tangazeni saumu takatifu;"},{"verse":15,"text":"Ole kwa siku hiyo!"},{"verse":16,"text":"Je, chakula hakikukatiliwa mbali"},{"verse":17,"text":"Mbegu zinakauka"},{"verse":18,"text":"Jinsi gani ngʼombe wanavyolia!"},{"verse":19,"text":"Kwako, Ee \\nd Bwana\\nd*, naita,"},{"verse":20,"text":"Hata wanyama wa porini wanakuonea shauku;"}]}