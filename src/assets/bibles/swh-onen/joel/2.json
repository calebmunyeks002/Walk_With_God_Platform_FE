{"verses":[{"verse":1,"text":"Pigeni tarumbeta katika Sayuni;"},{"verse":2,"text":"siku ya giza na huzuni,"},{"verse":3,"text":"Mbele yao moto unateketeza,"},{"verse":4,"text":"Wanaonekana kama farasi;"},{"verse":5,"text":"Wanatoa sauti kama magari ya vita,"},{"verse":6,"text":"Wanapoonekana, mataifa yanakuwa katika maumivu makuu;"},{"verse":7,"text":"Wanashambulia kama wapiganaji wa vita;"},{"verse":8,"text":"Hakuna anayemsukuma mwenzake;"},{"verse":9,"text":"Wanaenda kasi kuingia mjini;"},{"verse":10,"text":"Mbele yao dunia inatikisika,"},{"verse":11,"text":"\\nd Bwana\\nd* anatoa mshindo wa ngurumo"},{"verse":12,"text":"“Hata sasa,” asema \\nd Bwana\\nd*,"},{"verse":13,"text":"Rarueni mioyo yenu"},{"verse":14,"text":"Ni nani ajuaye? Yeye aweza kugeuka na kuwa na huruma"},{"verse":15,"text":"Pigeni tarumbeta katika Sayuni,"},{"verse":16,"text":"Wakusanyeni watu,"},{"verse":17,"text":"Makuhani, ambao wanahudumu mbele za \\nd Bwana\\nd*,"},{"verse":18,"text":"Kisha \\nd Bwana\\nd* atakuwa na wivu kwa ajili ya nchi yake"},{"verse":19,"text":"\\nd Bwana\\nd* atawajibu:"},{"verse":20,"text":"“Nitafukuza jeshi la kaskazini likae mbali nanyi,"},{"verse":21,"text":"Usiogope, ee nchi;"},{"verse":22,"text":"Msiogope, enyi wanyama pori,"},{"verse":23,"text":"Furahini, enyi watu wa Sayuni,"},{"verse":24,"text":"Sakafu za kupuria zitajaa nafaka,"},{"verse":25,"text":"“Nitawalipa kwa ajili ya miaka ile iliyoliwa na nzige:"},{"verse":26,"text":"Mtakuwa na wingi wa vyakula mpaka mshibe,"},{"verse":27,"text":"Ndipo mtakapojua kwamba mimi niko katika Israeli"},{"verse":28,"text":"“Hata itakuwa, baada ya hayo,"},{"verse":29,"text":"Hata juu ya watumishi wangu, wanaume kwa wanawake,"},{"verse":30,"text":"Nami nitaonyesha maajabu katika mbingu"},{"verse":31,"text":"Jua litageuzwa kuwa giza"},{"verse":32,"text":"Na kila mtu atakayeliitia"}]}