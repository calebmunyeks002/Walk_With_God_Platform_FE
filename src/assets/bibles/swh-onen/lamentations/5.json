{"verses":[{"verse":1,"text":"Kumbuka, Ee \\nd Bwana\\nd*, yaliyotupata,"},{"verse":2,"text":"Urithi wetu umegeuziwa kwa wageni,"},{"verse":3,"text":"Tumekuwa yatima wasio na baba,"},{"verse":4,"text":"Ni lazima tununue maji tunayokunywa,"},{"verse":5,"text":"Wanaotufuatilia wapo kwenye visigino vyetu,"},{"verse":6,"text":"Tumejitolea kwa Misri na Ashuru"},{"verse":7,"text":"Baba zetu walitenda dhambi na hawapo tena,"},{"verse":8,"text":"Watumwa wanatutawala"},{"verse":9,"text":"Tunapata chakula chetu kwa kuhatarisha maisha yetu"},{"verse":10,"text":"Ngozi yetu ina joto kama tanuru,"},{"verse":11,"text":"Wanawake wametendwa jeuri katika Sayuni,"},{"verse":12,"text":"Wakuu wametungikwa juu kwa mikono yao,"},{"verse":13,"text":"Vijana wanataabika kwenye mawe ya kusagia,"},{"verse":14,"text":"Wazee wameondoka langoni la mji,"},{"verse":15,"text":"Furaha imeondoka mioyoni mwetu,"},{"verse":16,"text":"Taji imeanguka kutoka kichwani petu."},{"verse":17,"text":"Kwa sababu hiyo, mioyo yetu inazimia,"},{"verse":18,"text":"kwa ajili ya Mlima Sayuni, ambao unakaa ukiwa,"},{"verse":19,"text":"Wewe, Ee \\nd Bwana\\nd* unatawala milele,"},{"verse":20,"text":"Kwa nini watusahau siku zote?"},{"verse":21,"text":"Turudishe kwako mwenyewe, Ee \\nd Bwana\\nd*,"},{"verse":22,"text":"isipokuwa uwe umetukataa kabisa"}]}