{"verses":[{"verse":1,"text":"Tazama jinsi mji ulivyoachwa ukiwa,"},{"verse":2,"text":"Kwa uchungu, hulia sana usiku,"},{"verse":3,"text":"Baada ya mateso na kufanyishwa kazi kikatili,"},{"verse":4,"text":"Barabara zielekeazo Sayuni zaomboleza,"},{"verse":5,"text":"Adui zake wamekuwa mabwana zake,"},{"verse":6,"text":"Fahari yote imeondoka"},{"verse":7,"text":"Katika siku za mateso yake na kutangatanga,"},{"verse":8,"text":"Yerusalemu ametenda dhambi sana"},{"verse":9,"text":"Uchafu wake umegandamana na nguo zake;"},{"verse":10,"text":"Adui ametia mikono"},{"verse":11,"text":"Watu wake wote wanalia kwa uchungu"},{"verse":12,"text":"“Je, si kitu kwenu, ninyi nyote mpitao kando?"},{"verse":13,"text":"“Kutoka juu alipeleka moto,"},{"verse":14,"text":"“Dhambi zangu zimefungwa kwenye nira,"},{"verse":15,"text":"“Bwana amewakataa wapiganaji wa vita"},{"verse":16,"text":"“Hii ndiyo sababu ninalia"},{"verse":17,"text":"Sayuni ananyoosha mikono yake,"},{"verse":18,"text":"“\\nd Bwana\\nd* ni mwenye haki,"},{"verse":19,"text":"“Niliita washirika wangu"},{"verse":20,"text":"“Angalia, Ee \\nd Bwana\\nd*, jinsi nilivyo katika dhiki!"},{"verse":21,"text":"“Watu wamesikia ninavyolia kwa uchungu,"},{"verse":22,"text":"“Uovu wao wote na uje mbele zako;"}]}