{"verses":[{"verse":1,"text":"Mimi ndiye mtu aliyeona mateso"},{"verse":2,"text":"Amenifukuzia mbali na kunifanya nitembee"},{"verse":3,"text":"hakika, amegeuza mkono wake dhidi yangu"},{"verse":4,"text":"Amefanya ngozi yangu na nyama yangu kuchakaa"},{"verse":5,"text":"Amenizingira na kunizunguka"},{"verse":6,"text":"Amenifanya niishi gizani"},{"verse":7,"text":"Amenizungushia ukuta ili nisiweze kutoroka,"},{"verse":8,"text":"Hata ninapoita au kulia ili kuomba msaada,"},{"verse":9,"text":"Ameizuia njia yangu kwa mapande ya mawe,"},{"verse":10,"text":"Kama dubu aviziaye,"},{"verse":11,"text":"ameniburuta kutoka njia,"},{"verse":12,"text":"Amevuta upinde wake"},{"verse":13,"text":"Alinichoma moyo wangu kwa mishale"},{"verse":14,"text":"Nimekuwa kichekesho kwa watu wangu wote,"},{"verse":15,"text":"Amenijaza kwa majani machungu"},{"verse":16,"text":"Amevunja meno yangu kwa changarawe,"},{"verse":17,"text":"Amani yangu imeondolewa,"},{"verse":18,"text":"Kwa hiyo nasema, “Fahari yangu imeondoka"},{"verse":19,"text":"Nayakumbuka mateso yangu na kutangatanga kwangu,"},{"verse":20,"text":"Ninayakumbuka vyema,"},{"verse":21,"text":"Hata hivyo najikumbusha neno hili"},{"verse":22,"text":"Kwa sababu ya upendo mkuu wa \\nd Bwana\\nd*, hatuangamii,"},{"verse":23,"text":"Ni mpya kila asubuhi,"},{"verse":24,"text":"Nimeiambia nafsi yangu, “\\nd Bwana\\nd* ni fungu langu,"},{"verse":25,"text":"\\nd Bwana\\nd* ni mwema kwa wale ambao tumaini lao ni kwake,"},{"verse":26,"text":"ni vyema kungojea kwa utulivu"},{"verse":27,"text":"Ni vyema mtu kuchukua nira"},{"verse":28,"text":"Na akae peke yake awe kimya,"},{"verse":29,"text":"Na azike uso wake mavumbini"},{"verse":30,"text":"Na atoe shavu lake kwa yule ampigaye,"},{"verse":31,"text":"Kwa kuwa watu hawakatiliwi mbali"},{"verse":32,"text":"Ingawa huleta huzuni, ataonyesha huruma,"},{"verse":33,"text":"Kwa maana hapendi kuwaletea mateso"},{"verse":34,"text":"Kuwaponda chini ya nyayo"},{"verse":35,"text":"Kumnyima mtu haki zake"},{"verse":36,"text":"kumnyima mtu haki:"},{"verse":37,"text":"Nani awezaye kusema nalo likatendeka"},{"verse":38,"text":"Je, si ni kwenye kinywa cha Aliye Juu Sana"},{"verse":39,"text":"Mwanadamu yeyote aliye hai aweza kulalamika"},{"verse":40,"text":"Tuzichunguze njia zetu na kuzijaribu,"},{"verse":41,"text":"Tuinue mioyo yetu pamoja na mikono yetu"},{"verse":42,"text":"“Tumetenda dhambi na kuasi"},{"verse":43,"text":"“Umejifunika mwenyewe kwa hasira na kutufuatilia;"},{"verse":44,"text":"Unajifunika mwenyewe kwa wingu,"},{"verse":45,"text":"Umetufanya takataka na uchafu"},{"verse":46,"text":"“Adui zetu wote wamefumbua vinywa vyao"},{"verse":47,"text":"Tumeteseka kwa hofu kuu na shida ya ghafula,"},{"verse":48,"text":"Vijito vya machozi vinatiririka kutoka machoni mwangu,"},{"verse":49,"text":"Macho yangu yatatiririka machozi bila kukoma,"},{"verse":50,"text":"hadi \\nd Bwana\\nd* atazame chini"},{"verse":51,"text":"Lile ninaloliona huniletea huzuni nafsini"},{"verse":52,"text":"Wale waliokuwa adui zangu bila sababu"},{"verse":53,"text":"Walijaribu kukomesha maisha yangu ndani ya shimo"},{"verse":54,"text":"maji yalifunika juu ya kichwa changu,"},{"verse":55,"text":"Nililiitia jina lako, Ee \\nd Bwana\\nd*,"},{"verse":56,"text":"Ulisikia ombi langu: “Usikizibie masikio yako"},{"verse":57,"text":"Ulikuja karibu nilipokuita,"},{"verse":58,"text":"Ee Bwana, ulichukua shauri langu,"},{"verse":59,"text":"Umeona, Ee \\nd Bwana\\nd*, ubaya niliotendewa."},{"verse":60,"text":"Umeona kina cha kisasi chao,"},{"verse":61,"text":"Ee \\nd Bwana\\nd*, umesikia matukano yao,"},{"verse":62,"text":"kile adui zangu wanachonongʼona na kunungʼunikia"},{"verse":63,"text":"Watazame! Wakiwa wameketi au wamesimama,"},{"verse":64,"text":"Uwalipe kile wanachostahili, Ee \\nd Bwana\\nd*,"},{"verse":65,"text":"Weka pazia juu ya mioyo yao,"},{"verse":66,"text":"Wafuatilie katika hasira na uwaangamize"}]}