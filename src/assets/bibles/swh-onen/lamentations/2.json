{"verses":[{"verse":1,"text":"Tazama jinsi Bwana alivyomfunika Binti Sayuni"},{"verse":2,"text":"Bila huruma Bwana ameyameza"},{"verse":3,"text":"Katika hasira kali amevunja"},{"verse":4,"text":"Ameupinda upinde wake kama adui,"},{"verse":5,"text":"Bwana ni kama adui;"},{"verse":6,"text":"Ameharibu maskani yake kama bustani,"},{"verse":7,"text":"Bwana amekataa madhabahu yake"},{"verse":8,"text":"\\nd Bwana\\nd* alikusudia kuangusha"},{"verse":9,"text":"Malango yake yamezama ardhini,"},{"verse":10,"text":"Wazee wa Binti Sayuni"},{"verse":11,"text":"Macho yangu yamedhoofika kwa kulia,"},{"verse":12,"text":"Wanawaambia mama zao,"},{"verse":13,"text":"Ninaweza kusema nini kwa ajili yako?"},{"verse":14,"text":"Maono ya manabii wako"},{"verse":15,"text":"Wote wapitiao njia yako"},{"verse":16,"text":"Adui zako wote wanapanua"},{"verse":17,"text":"\\nd Bwana\\nd* amefanya lile alilolipanga;"},{"verse":18,"text":"Mioyo ya watu"},{"verse":19,"text":"Inuka, lia usiku,"},{"verse":20,"text":"“Tazama, Ee \\nd Bwana\\nd*, ufikirie:"},{"verse":21,"text":"“Vijana na wazee hujilaza pamoja"},{"verse":22,"text":"“Kama ulivyoita siku ya karamu,"}]}