{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": { "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"] }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/assets/**", "/icons/**", "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"] }
    }
  ],
  "dataGroups": [
    {
      "name": "bible-api",
      "urls": ["https://raw.githubusercontent.com/wldeh/bible-api/**", "https://walk-with-god-platform-api.onrender.com/api/bible/**"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 200, "maxAge": "7d", "timeout": "5s" }
    },
    {
      "name": "media",
      "urls": ["https://walk-with-god-platform-api.onrender.com/api/media/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 100, "maxAge": "7d" }
    }
  ]
}